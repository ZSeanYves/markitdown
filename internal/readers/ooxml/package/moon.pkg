import {
  "ZSeanYves/markitdown/internal/readers/zip",
  "ZSeanYves/markitdown/internal/readers/xml",
  "ZSeanYves/markitdown/internal/readers/source_io" @sourceio,
  "moonbitlang/core/encoding/utf8",
