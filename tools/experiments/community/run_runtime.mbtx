import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    fail("usage: run_runtime.mbtx <repository-root> <native|wasm>")
  }
  let root = args[1]
  let target = args[2]
  guard target == "native" || target == "wasm" else { fail("invalid target") }
  let work = root + "/.tmp/community-runtime-probe"
  @fs.mkdir(work, recursive=true, allow_exist=true)
  let module_source =
    #|name = "local/markitdown_runtime_probe"
    #|version = "0.0.0"
    #|import { "moonbitlang/async@0.22.4" }
    #|preferred_target = "wasm"
  @fs.write_file(work + "/moon.mod", module_source)
  let package_source =
    #|import {
    #|  "moonbitlang/async",
    #|  "moonbitlang/async/fs",
    #|} for "wbtest"
    #|supported_targets = "native+wasm"
  @fs.write_file(work + "/moon.pkg", package_source)
  @fs.write_file(work + "/runtime_wbtest.mbt",
    @fs.read_file(root + "/tools/experiments/community/runtime_probe.mbt"))
  @shell.Cmd("moon", ["test", "--target", target], cwd=work).run()
}
