import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    fail("usage: run_codec.mbtx <repository-root> <native|wasm>")
  }
  let root = args[1]
  let target = args[2]
  guard target == "native" || target == "wasm" else { fail("invalid target") }
  let work = root + "/.tmp/community-codec-probe"
  @fs.mkdir(work, recursive=true, allow_exist=true)
  let module_source =
    #|name = "local/markitdown_codec_probe"
    #|version = "0.0.0"
    #|import {
    #|  "bikallem/compress@0.3.4",
    #|  "moonbit-community/flate@0.8.5",
    #|  "moonbitlang/async@0.22.4",
    #|}
    #|preferred_target = "wasm"
  @fs.write_file(work + "/moon.mod", module_source)
  let package_source =
    #|import {
    #|  "bikallem/compress/flate" @old_flate,
    #|  "bikallem/compress/zlib" @old_zlib,
    #|  "moonbit-community/flate",
    #|  "moonbit-community/flate/zlib",
    #|  "moonbit-community/flate/checksum",
    #|  "moonbitlang/core/encoding/utf16",
    #|  "moonbitlang/core/encoding/utf8",
    #|} for "wbtest"
    #|supported_targets = "native+wasm"
  @fs.write_file(work + "/moon.pkg", package_source)
  @fs.write_file(work + "/codec_wbtest.mbt",
    @fs.read_file(root + "/tools/experiments/community/codec_probe.mbt"))
  @shell.Cmd("moon", ["test", "--target", target], cwd=work).run()
}
