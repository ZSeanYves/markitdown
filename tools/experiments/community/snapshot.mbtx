import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    fail("usage: snapshot.mbtx <registry-index-directory> <output.json>")
  }
  let packages = [
    "bikallem/blit", "bikallem/compress", "moonbitlang/async", "moonbitlang/x",
    "tonyfettes/encoding", "moonbit-community/flate", "horideicom/encoding_sjis",
    "Milky2018/xml", "bobzhang/html_parser", "moonbit-community/toml",
    "moonbit-community/cmark", "mizchi/markdown", "moonbitlang/docx2html",
    "moonbitlang/mbtexcel", "t-ujiie-g/moon-pptx", "oyjh0381/moonmime",
    "moonbitlang/pdflite", "moonbitstack/moonyaml", "moonbit-community/yaml",
  ]
  let snapshot : Map[String, Json] = Map([])
  for module_name in packages {
    let text = @fs.read_file(args[1] + "/user/" + module_name + ".index").text()
    let releases : Array[Json] = []
    for line in text.split("\n") {
      if !line.is_empty() {
        releases.push(@json.parse(line))
      }
    }
    guard !releases.is_empty() else { fail("empty index: " + module_name) }
    snapshot.set(module_name, releases.to_json())
  }
  @fs.write_file(args[2], snapshot.to_json().stringify(indent=2) + "\n")
  println("Recorded " + packages.length().to_string() + " package histories")
}
