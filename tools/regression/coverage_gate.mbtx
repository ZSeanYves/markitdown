import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

struct CoverageFile {
  path : String
  group : String
  covered : Int
  valid : Int
}

struct CoverageGroup {
  name : String
  threshold : Double
  covered : Int
  valid : Int
}

struct FormatCoverage {
  name : String
  covered : Int
  valid : Int
}

struct LineStat {
  number : Int
  hits : Int
}

let excluded_files : Array[String] = [
  "internal/bench_runner/main.mbt",
  "main.mbt",
  "internal/readers/pdf/font_encoding_tables.mbt",
  "internal/readers/pdf/gb2312_data.mbt",
  "internal/readers/pdf/predefined_cmap_data.mbt",
  "internal/runtime/process/process.mbt",
]

let known_formats : Array[String] = [
  "asciidoc", "csv", "docx", "eml", "epub", "html", "ipynb", "json",
  "markdown", "odp", "ods", "odt", "pdf", "pptx", "rst", "srt", "tex",
  "toml", "tsv", "txt", "vtt", "xlsx", "xml", "yaml", "zip",
]

fn int_from_text(text : String) -> Int {
  let mut value = 0
  let mut sign = 1
  let mut started = false
  for ch in text.trim() {
    if !started && ch == '-' {
      sign = -1
      started = true
    } else if ch >= '0' && ch <= '9' {
      value = value * 10 + ch.to_int() - '0'.to_int()
      started = true
    } else if started {
      break
    }
  }
  if started { value * sign } else { 0 }
}

fn double_from_text(text : String) -> Double raise {
  @string.parse_double(text.trim())
}

fn rounded4(value : Double) -> Double {
  ((value * 10000.0 + 0.5).to_int().to_double()) / 10000.0
}

fn decimal_string(value : Double, places : Int) -> String {
  let scale = if places == 0 { 1 } else if places == 2 { 100 } else { 10000 }
  let scaled = Double::round(value * scale.to_double()).to_int()
  let negative = scaled < 0
  let magnitude = if negative { -scaled } else { scaled }
  let whole = magnitude / scale
  if places == 0 {
    return (if negative { "-" } else { "" }) + whole.to_string()
  }
  let fraction = magnitude % scale
  let fraction_text = fraction.to_string()
  let mut padding = ""
  let padding_count = places - fraction_text.length()
  for _ in 0..<padding_count { padding += "0" }
  (if negative { "-" } else { "" }) + whole.to_string() + "." + padding + fraction_text
}

fn json_number(value : Int) -> Json {
  value.to_double().to_json()
}

fn json_double(value : Double) -> Json {
  rounded4(value).to_json()
}

fn json_bool(value : Bool) -> Json {
  value.to_json()
}

fn attr(fragment : StringView, key : String) -> String? {
  let marker = key + "=\""
  let parts = fragment.split(marker).to_array()
  if parts.length() < 2 {
    return None
  }
  Some(parts[1].split("\"").to_array()[0].to_owned())
}

fn xml_unescape(value : String) -> String {
  value
    .replace(old="&quot;", new="\"")
    .replace(old="&apos;", new="'")
    .replace(old="&lt;", new="<")
    .replace(old="&gt;", new=">")
    .replace(old="&amp;", new="&")
}

fn parse_line_stats(class_body : String) -> Array[LineStat] {
  let lines : Array[LineStat] = []
  for raw in class_body.split("<line ") {
    if !raw.contains("number=") || !raw.contains("hits=") {
      continue
    }
    let number = int_from_text(attr(raw, "number").unwrap_or("0"))
    let hits = int_from_text(attr(raw, "hits").unwrap_or("0"))
    lines.push({ number, hits })
  }
  lines
}

fn parse_classes(xml : String) -> Array[(String, Array[LineStat])] {
  let classes : Array[(String, Array[LineStat])] = []
  for raw in xml.split("<class ") {
    if !raw.contains("filename=") {
      continue
    }
    let filename = xml_unescape(attr(raw, "filename").unwrap_or(""))
    let body = raw.split("</class>").to_array()[0].to_owned()
    classes.push((filename, parse_line_stats(body)))
  }
  classes
}

fn group_for(path : String) -> (String, Double)? {
  if path.has_prefix("lib/input/") || path.has_prefix("lib/convert/") ||
    path.has_prefix("internal/parser/") || path.has_prefix("internal/pipeline/") ||
    path.has_prefix("internal/runtime/") || path.has_prefix("lib/render/") ||
    path.has_prefix("lib/core/") || path.has_prefix("lib/product/") ||
    path.has_prefix("lib/rag/") {
    return Some(("core", 90.0))
  }
  if path.has_prefix("lib/formats/") || path.has_prefix("internal/readers/") ||
    path.has_prefix("lib/container/") || path.has_prefix("internal/formats/") ||
    path.has_prefix("internal/format_readers/") {
    return Some(("formats", 80.0))
  }
  if path.has_prefix("internal/cli/") || path.has_prefix("internal/bench_runner/") {
    return Some(("tools", 70.0))
  }
  None
}

fn format_for(path : String) -> String? {
  let prefixes = [
    "internal/readers/ooxml/", "internal/readers/odf/", "lib/formats/",
    "internal/readers/", "internal/formats/",
  ]
  for prefix in prefixes {
    if path.has_prefix(prefix) {
      let rest = path[prefix.length():]
      let name = rest.split("/").to_array()[0].to_owned()
      if known_formats.contains(name) {
        return Some(name)
      }
    }
  }
  None
}

fn summarize_text(xml : String) -> (Array[CoverageGroup], Array[CoverageFile], Array[FormatCoverage], Bool) {
  let groups : Map[String, CoverageGroup] = Map([
    ("core", { name: "core", threshold: 90.0, covered: 0, valid: 0 }),
    ("formats", { name: "formats", threshold: 80.0, covered: 0, valid: 0 }),
    ("tools", { name: "tools", threshold: 70.0, covered: 0, valid: 0 }),
  ])
  let files : Array[CoverageFile] = []
  for (path, line_stats) in parse_classes(xml) {
    if excluded_files.contains(path) {
      continue
    }
    match group_for(path) {
      None => continue
      Some((name, threshold)) => {
        let valid = line_stats.length()
        let covered = line_stats.filter(line => line.hits > 0).length()
        let old = groups.get(name).unwrap()
        groups[name] = { ..old, threshold, covered: old.covered + covered, valid: old.valid + valid }
        files.push({ path, group: name, covered, valid })
      }
    }
  }
  let group_values = [groups.get("core").unwrap(), groups.get("formats").unwrap(), groups.get("tools").unwrap()]
  let group_passed = group_values.all(group => {
    let rate = if group.valid == 0 { 100.0 } else { group.covered.to_double() * 100.0 / group.valid.to_double() }
    rate >= group.threshold
  })
  let format_map : Map[String, (Int, Int)] = Map([])
  for file in files {
    match format_for(file.path) {
      Some(name) => {
        let old = format_map.get(name).unwrap_or((0, 0))
        format_map[name] = (old.0 + file.covered, old.1 + file.valid)
      }
      None => ()
    }
  }
  let formats : Array[FormatCoverage] = []
  let names = format_map.keys().to_array()
  names.sort_by(fn(left, right) { left.compare(right) })
  for name in names {
    let values = format_map.get(name).unwrap()
    formats.push({ name, covered: values.0, valid: values.1 })
  }
  files.sort_by(fn(left, right) {
    let group_order = left.group.compare(right.group)
    if group_order != 0 {
      group_order
    } else {
      let left_rate = if left.valid == 0 {
        1.0
      } else {
        left.covered.to_double() / left.valid.to_double()
      }
      let right_rate = if right.valid == 0 {
        1.0
      } else {
        right.covered.to_double() / right.valid.to_double()
      }
      if left_rate < right_rate {
        -1
      } else if left_rate > right_rate {
        1
      } else {
        left.path.compare(right.path)
      }
    }
  })
  (group_values, files, formats, group_passed)
}

fn rate(covered : Int, valid : Int) -> Double {
  if valid == 0 { 100.0 } else { covered.to_double() * 100.0 / valid.to_double() }
}

fn group_json(group : CoverageGroup) -> Json {
  Json::object({
    "name": group.name.to_json(),
    "covered": json_number(group.covered),
    "valid": json_number(group.valid),
    "rate": json_double(rate(group.covered, group.valid)),
    "threshold": json_double(group.threshold),
    "passed": json_bool(rate(group.covered, group.valid) >= group.threshold),
  })
}

fn file_json(file : CoverageFile) -> Json {
  Json::object({
    "path": file.path.to_json(),
    "group": file.group.to_json(),
    "covered": json_number(file.covered),
    "valid": json_number(file.valid),
  })
}

fn format_json(format : FormatCoverage) -> Json {
  Json::object({
    "name": format.name.to_json(),
    "covered": json_number(format.covered),
    "valid": json_number(format.valid),
    "rate": json_double(rate(format.covered, format.valid)),
  })
}

fn json_field_string(value : Json, key : String) -> String? {
  match value {
    Object(fields) => match fields.get(key) {
      Some(String(text)) => Some(text)
      _ => None
    }
    _ => None
  }
}

fn json_field_double(value : Json, key : String) -> Double? {
  match value {
    Object(fields) => match fields.get(key) {
      Some(Number(value, ..)) => Some(value)
      _ => None
    }
    _ => None
  }
}

fn json_field_int_string(value : Json, key : String) -> String {
  match value {
    Object(fields) => match fields.get(key) {
      Some(Number(number, ..)) => number.to_int().to_string()
      _ => ""
    }
    _ => ""
  }
}

async fn baseline_rates(path : String) -> Map[String, Double]? {
  if !@fs.exists(path) {
    return None
  }
  let parsed = @json.parse(@fs.read_file(path).text())
  match parsed {
    Object(fields) => match fields.get("formats") {
      Some(Array(items)) => {
        let values : Map[String, Double] = Map([])
        for item in items {
          match (json_field_string(item, "name"), json_field_double(item, "rate")) {
            (Some(name), Some(value)) => values[name] = value
            _ => ()
          }
        }
        Some(values)
      }
      _ => match fields.get("files") {
        Some(Array(items)) => {
          let totals : Map[String, (Int, Int)] = Map([])
          for item in items {
            match (json_field_string(item, "path"), json_field_double(item, "covered"), json_field_double(item, "valid")) {
              (Some(path), Some(covered), Some(valid)) => match format_for(path) {
                Some(name) => {
                  let old = totals.get(name).unwrap_or((0, 0))
                  totals[name] = (old.0 + covered.to_int(), old.1 + valid.to_int())
                }
                None => ()
              }
              _ => ()
            }
          }
          let values : Map[String, Double] = Map([])
          for name, (covered, valid) in totals {
            values[name] = rate(covered, valid)
          }
          Some(values)
        }
        _ => Some(Map([]))
      }
    }
    _ => Some(Map([]))
  }
}

async fn format_ratchet(formats : Array[FormatCoverage], baseline_path : String?, max_drop : Double) -> (String, Array[Json], Bool) {
  match baseline_path {
    None => ("not_configured", [], true)
    Some(path) => match baseline_rates(path) {
      None => ("baseline_missing", [], false)
      Some(baseline) => {
        let entries : Array[Json] = []
        let mut passed = true
        for format in formats {
          match baseline.get(format.name) {
            Some(old_rate) => {
              let current = rate(format.covered, format.valid)
              let drop = old_rate - current
              let entry_passed = drop <= max_drop
              if !entry_passed { passed = false }
              entries.push(Json::object({
                "name": format.name.to_json(),
                "baseline_rate": json_double(old_rate),
                "current_rate": json_double(current),
                "drop": json_double(drop),
                "passed": json_bool(entry_passed),
              }))
            }
            None => ()
          }
        }
        (if passed { "pass" } else { "fail" }, entries, passed)
      }
    }
  }
}

async fn changed_lines(root : String, baseline_ref : String) -> Map[String, Array[Int]]? {
  let output = @shell.Cmd("git", [
    "diff", "--unified=0", "--diff-filter=AM", baseline_ref, "--", ":(glob)**/*.mbt",
  ], cwd=root).output()
  if output.exit_code() != 0 {
    return None
  }
  let added : Map[String, Array[Int]] = Map([])
  let mut current : String? = None
  for line in output.stdout().split("\n") {
    if line.has_prefix("+++ b/") {
      current = Some(line[6:].to_owned())
      continue
    }
    if !line.has_prefix("@@ ") {
      continue
    }
    match current {
      None => ()
      Some(path) => {
        let halves = line.split("+").to_array()
        if halves.length() < 2 { continue }
        let right = halves[1].split(" ").to_array()[0]
        let range = right.split(",").to_array()
        let start = int_from_text(range[0].to_owned())
        let count = if range.length() > 1 { int_from_text(range[1].to_owned()) } else { 1 }
        let values = added.get(path).unwrap_or([])
        for index in 0..<count { values.push(start + index) }
        added[path] = values
      }
    }
  }
  Some(added)
}

async fn new_code_summary(root : String, xml : String, baseline_ref : String?, threshold : Double) -> Json {
  match baseline_ref {
    None => Json::object({
      "status": "not_configured".to_json(), "covered": json_number(0), "valid": json_number(0),
      "rate": json_double(100.0), "threshold": json_double(threshold), "passed": json_bool(true),
    })
    Some(reference) => match changed_lines(root, reference) {
      None => Json::object({
        "status": "baseline_ref_unavailable".to_json(), "covered": json_number(0), "valid": json_number(0),
        "rate": json_double(0.0), "threshold": json_double(threshold), "passed": json_bool(false),
      })
      Some(changed) => {
        let mut covered = 0
        let mut valid = 0
        for (path, lines) in parse_classes(xml) {
          if excluded_files.contains(path) || path.has_suffix("_test.mbt") || path.has_suffix("_wbtest.mbt") || group_for(path) is None {
            continue
          }
          for line in lines {
            if changed.get(path) is Some(changed_lines) && changed_lines.contains(line.number) {
              valid += 1
              if line.hits > 0 { covered += 1 }
            }
          }
        }
        let current = rate(covered, valid)
        let passed = current >= threshold
        Json::object({
          "status": (if passed { "pass" } else { "fail" }).to_json(),
          "covered": json_number(covered), "valid": json_number(valid),
          "rate": json_double(current), "threshold": json_double(threshold), "passed": json_bool(passed),
        })
      }
    }
  }
}

async fn summary_json(xml : String, root : String, baseline : String?, baseline_ref : String?, max_drop : Double, new_threshold : Double) -> (Json, Bool) {
  let (groups, files, formats, groups_passed) = summarize_text(xml)
  let (ratchet_status, ratchet_entries, ratchet_passed) = format_ratchet(formats, baseline, max_drop)
  let new_code = new_code_summary(root, xml, baseline_ref, new_threshold)
  let new_code_passed = match new_code {
    Object(fields) => fields.get("passed") == Some(true.to_json())
    _ => false
  }
  let passed = groups_passed && ratchet_passed && new_code_passed
  let summary = Json::object({
    "schema_version": json_number(1),
    "groups": groups.map(group_json).to_json(),
    "files": files.map(file_json).to_json(),
    "formats": formats.map(format_json).to_json(),
    "excluded_files": excluded_files.to_json(),
    "format_ratchet": Json::object({
      "status": ratchet_status.to_json(), "max_drop": json_double(max_drop),
      "entries": ratchet_entries.to_json(), "passed": json_bool(ratchet_passed),
    }),
    "new_code": new_code,
    "passed": json_bool(passed),
  })
  (summary, passed)
}

async fn write_outputs(summary : Json, output_dir : String) -> Unit {
  @fs.mkdir(output_dir, recursive=true, allow_exist=true)
  @fs.write_file(output_dir + "/coverage.json", summary.stringify(indent=2) + "\n")
  let groups : Array[Json] = match summary {
    Object(fields) => match fields.get("groups") {
      Some(Array(values)) => values
      _ => []
    }
    _ => []
  }
  let tsv = ["group\tcovered\tvalid\trate\tthreshold\tpassed"]
  let markdown = [
    "# Coverage Gate", "", "| Group | Covered | Valid | Rate | Threshold | Status |",
    "| --- | ---: | ---: | ---: | ---: | --- |",
  ]
  for group in groups {
    let name = json_field_string(group, "name").unwrap_or("")
    let covered = json_field_int_string(group, "covered")
    let valid = json_field_int_string(group, "valid")
    let rate = json_field_double(group, "rate").unwrap_or(0.0)
    let threshold = json_field_double(group, "threshold").unwrap_or(0.0)
    let passed = match group {
      Object(fields) => fields.get("passed") == Some(true.to_json())
      _ => false
    }
    tsv.push(name + "\t" + covered + "\t" + valid + "\t" + decimal_string(rate, 4) + "\t" + decimal_string(threshold, 1) + "\t" + (if passed { "pass" } else { "fail" }))
    markdown.push("| " + name + " | " + covered + " | " + valid + " | " + decimal_string(rate, 2) + "% | " + decimal_string(threshold, 0) + "% | " + (if passed { "pass" } else { "fail" }) + " |")
  }
  let ratchet : Json? = match summary {
    Object(fields) => fields.get("format_ratchet")
    _ => None
  }
  markdown.push("\n## Format Ratchet\n")
  match ratchet {
    Some(Object(fields)) => match fields.get("entries") {
      Some(Array(entries)) => for entry in entries {
        let name = json_field_string(entry, "name").unwrap_or("")
        let old = json_field_double(entry, "baseline_rate").unwrap_or(0.0)
        let current = json_field_double(entry, "current_rate").unwrap_or(0.0)
        let drop = json_field_double(entry, "drop").unwrap_or(0.0)
        let passed = match entry {
          Object(item) => item.get("passed") == Some(true.to_json())
          _ => false
        }
        markdown.push("| " + name + " | " + decimal_string(old, 2) + "% | " + decimal_string(current, 2) + "% | " + decimal_string(drop, 2) + " pp | " + (if passed { "pass" } else { "fail" }) + " |")
      }
      _ => ()
    }
    _ => ()
  }
  let new_code : Json? = match summary {
    Object(fields) => fields.get("new_code")
    _ => None
  }
  markdown.push("\n## New Production Code\n")
  markdown.push("- Status: " + new_code.map_or("unknown", value => json_field_string(value, "status").unwrap_or("unknown")))
  let new_covered = new_code.map_or("0", value => json_field_int_string(value, "covered"))
  let new_valid = new_code.map_or("0", value => json_field_int_string(value, "valid"))
  let new_rate = new_code.map_or(0.0, value => json_field_double(value, "rate").unwrap_or(0.0))
  let new_threshold = new_code.map_or(0.0, value => json_field_double(value, "threshold").unwrap_or(0.0))
  markdown.push("- Coverage: " + decimal_string(new_rate, 2) + "% (" + new_covered + "/" + new_valid + ")")
  markdown.push("- Threshold: " + decimal_string(new_threshold, 0) + "%")
  @fs.write_file(output_dir + "/coverage.tsv", tsv.join("\n") + "\n")
  @fs.write_file(output_dir + "/coverage.md", markdown.join("\n") + "\n")
}

async fn run_self_test() -> Unit raise {
  let xml = "<coverage><packages><package><classes>" +
    "<class filename=\"lib/convert/a.mbt\"><lines><line number=\"1\" hits=\"1\"/><line number=\"2\" hits=\"0\"/></lines></class>" +
    "<class filename=\"lib/formats/html/parser.mbt\"><lines><line number=\"1\" hits=\"1\"/></lines></class>" +
    "<class filename=\"internal/cli/a.mbt\"><lines><line number=\"1\" hits=\"0\"/></lines></class>" +
    "<class filename=\"main.mbt\"><lines><line number=\"1\" hits=\"0\"/></lines></class>" +
    "</classes></package></packages></coverage>"
  let (groups, files, formats, passed) = summarize_text(xml)
  assert_eq(groups[0].name, "core")
  assert_eq(groups[0].covered, 1)
  assert_eq(groups[0].valid, 2)
  assert_eq(groups[1].name, "formats")
  assert_eq(rate(groups[1].covered, groups[1].valid), 100.0)
  assert_eq(groups[2].name, "tools")
  assert_eq(rate(groups[2].covered, groups[2].valid), 0.0)
  assert_true(!passed)
  assert_eq(files.length(), 3)
  assert_eq(formats[0].name, "html")
  assert_eq(format_for("formats/pdf/parser.mbt"), None)
  let (summary, _) = summary_json(xml, ".", None, None, 0.5, 80.0)
  assert_true(summary.stringify().contains("\"covered\":1"))
  println("coverage gate self-test passed")
}

async fn main {
  let args = @env.args()
  if args.length() == 2 && args[1] == "--self-test" {
    run_self_test()
    return
  }
  let mut cobertura : String? = None
  let mut output_dir : String? = None
  let mut baseline : String? = None
  let mut baseline_ref : String? = None
  let mut enforce = false
  let mut max_drop = 0.5
  let mut new_threshold = 80.0
  let mut index = 1
  while index < args.length() {
    let arg = args[index]
    if arg == "--enforce" { enforce = true; index += 1; continue }
    if index + 1 >= args.length() { fail("missing value for " + arg) }
    let value = args[index + 1]
    if arg == "--cobertura" { cobertura = Some(value) }
    else if arg == "--output-dir" { output_dir = Some(value) }
    else if arg == "--baseline" { baseline = Some(value) }
    else if arg == "--baseline-ref" { baseline_ref = Some(value) }
    else if arg == "--max-format-drop" { max_drop = double_from_text(value) }
    else if arg == "--new-code-threshold" { new_threshold = double_from_text(value) }
    else { fail("unknown argument: " + arg) }
    index += 2
  }
  let xml_path = match cobertura {
    Some(path) => path
    None => fail("--cobertura is required")
  }
  let out_path = match output_dir {
    Some(path) => path
    None => fail("--output-dir is required")
  }
  let root = @env.current_dir().unwrap_or(".")
  let xml = @fs.read_file(xml_path).text()
  let (summary, passed) = summary_json(xml, root, baseline, baseline_ref, max_drop, new_threshold)
  write_outputs(summary, out_path)
  if enforce && !passed { fail("coverage gate failed") }
}
