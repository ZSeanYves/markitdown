  assert_eq(
    measurement_scope("partial_v11", "budget_working_payload_peak_bytes"),
    "zip_ooxml_content_types_relationships_core_app_custom_namespace_and_scalar_buffers_docx_paragraph_utf8_feed_token_fields_and_raw_inline_ranges_pdf_flate_indexed_stream_range_pending_image_descriptor_refbuffer_and_scope_name_utf16_cli_source_asset_collection_bounded_read_payload_modeled_scratch_upper_bound_and_xlsx_worksheet_cursor_utf8_feed_token_namespace_payload_upper_bound;raw_selection_buffers_and_other_working_unmeasured",
  )
  assert_eq(
    counter_unit("partial_v11", "budget_working_payload_peak_bytes"),
    "bytes",
  )
  assert_true(
    measurement_scope("partial_v11", "budget_cache_payload_peak_bytes") !=
    measurement_scope("partial_v10", "budget_cache_payload_peak_bytes"),
  )
  assert_eq(
    measurement_scope("partial_v11", "unknown"),
    "unmeasured_unknown_dimension",
  )
  let expected_scopes : Map[String, String] = {
    "budget_read_traffic_bytes": "input_read_view_memory_payload_and_cli_admitted_opened_source_asset_read_traffic",
    "budget_inflate_bytes": "zip_and_pdf_flate_output_only;other_inflate_and_pdf_non_flate_unmeasured",
    "budget_output_admitted_utf8_bytes": "output_write_admission",
    "budget_output_confirmed_utf8_bytes": "confirmed_successful_output_writes",
    "budget_parse_work": "ooxml_cursor_utf8_selected_core_app_docx_paragraph_with_synthetic_roots_and_emitted_custom_serialized_scalars_yaml_logical_nodes_merge_copies_pdf_probe_bytes_code_units_entries_visits_comparisons_and_object_stream_code_units_and_xlsx_worksheet_cursor_utf8_work;other_parse_work_unmeasured",
    "budget_source_metadata_bytes": "ooxml_content_types_relationships_row_index_selected_core_app_custom_name_type_value_and_docx_paragraph_escaping_string_utf8_payload_only;other_source_metadata_unmeasured",
    "budget_cache_payload_peak_bytes": "zip_ooxml_content_types_relationships_core_app_custom_docx_paragraph_escaping_strings_pdf_probe_indexed_dictionary_range_object_stream_cli_source_asset_and_ranged_font_program_and_ranged_local_cmap_postparse_and_ranged_font_local_result_postparse_and_ranged_objstm_local_result_postparse_native64_selected_fields_slots_strings_retained_payload_upper_bound;allocator_outer_cmap_font_and_objstm_result_map_bookkeeping_parse_merge_filter_key_scratch_and_other_cache_unmeasured",
    "budget_working_payload_peak_bytes": "zip_ooxml_content_types_relationships_core_app_custom_namespace_and_scalar_buffers_docx_paragraph_utf8_feed_token_fields_and_raw_inline_ranges_pdf_flate_indexed_stream_range_pending_image_descriptor_refbuffer_and_scope_name_utf16_cli_source_asset_collection_bounded_read_payload_modeled_scratch_upper_bound_and_xlsx_worksheet_cursor_utf8_feed_token_namespace_payload_upper_bound;raw_selection_buffers_and_other_working_unmeasured",
  }
  let valid_scope_row = fn(row : String) {
    let columns = row.split("\t").to_array()
    columns.length() == 10 &&
    columns[1] == "partial_v11" &&
    expected_scopes.get(columns[6].to_owned()) == Some(columns[9].to_owned())
  }
  let v11_rows = report.values.filter(row => {
    row.split("\t").to_array()[1] == "partial_v11"
  })
  assert_eq(v11_rows.length(), 16)
  for row in v11_rows {
    assert_true(valid_scope_row(row))
  }
  let cache_rows = v11_rows.filter(row => {
    row.split("\t").to_array()[6] == "budget_cache_payload_peak_bytes"
  })
  assert_eq(cache_rows.length(), 2)
  for row in cache_rows {
    let columns = row.split("\t").map(value => value.to_owned()).to_array()
    columns[9] = measurement_scope(
      "partial_v10", "budget_cache_payload_peak_bytes",
    )
    assert_false(valid_scope_row(columns.join("\t")))
    columns[9] = "all_cache_and_rss_complete"
    assert_false(valid_scope_row(columns.join("\t")))
  }
  assert_true(
    measurement_scope("partial_v11", "budget_parse_work") !=
    measurement_scope("partial_v10", "budget_parse_work"),
  )
  for
    row in v11_rows.filter(row => {
      row.split("\t").to_array()[6] == "budget_parse_work"
    }) {
    let columns = row.split("\t").map(value => value.to_owned()).to_array()
    columns[9] = measurement_scope("partial_v10", "budget_parse_work")
    assert_false(valid_scope_row(columns.join("\t")))
  }
  assert_true(
    measurement_scope("partial_v11", "budget_working_payload_peak_bytes") !=
    measurement_scope("partial_v10", "budget_working_payload_peak_bytes"),
  )
  for
    row in v11_rows.filter(row => {
      row.split("\t").to_array()[6] == "budget_working_payload_peak_bytes"
    }) {
    let columns = row.split("\t").map(value => value.to_owned()).to_array()
    columns[9] = measurement_scope(
      "partial_v10", "budget_working_payload_peak_bytes",
    )
    assert_false(valid_scope_row(columns.join("\t")))
  }
  assert_true(
    measurement_scope("partial_v11", "budget_cache_payload_peak_bytes") !=
    measurement_scope("partial_v10", "budget_cache_payload_peak_bytes"),
  )
  for
    row in v11_rows.filter(row => {
      row.split("\t").to_array()[6] == "budget_cache_payload_peak_bytes"
    }) {
    let columns = row.split("\t").map(value => value.to_owned()).to_array()
    columns[9] = measurement_scope(
      "partial_v10", "budget_cache_payload_peak_bytes",
    )
    assert_false(valid_scope_row(columns.join("\t")))
  }
}

///|
fn v12_get(value : Json, key : String) -> Json raise {
  guard value is Object(fields) else { fail("v12 object required") }
  fields.get(key).unwrap_or_else(() => fail("v12 missing field: " + key))
}

///|
fn v12_text(value : Json) -> String raise {
  guard value is String(text) else { fail("v12 JSON string required") }
  text
}

///|
fn v12_nat(value : Json) -> Int64 raise {
  let text = v12_text(value)
  guard text != "" && (text == "0" || text[0] != '0') else {
    fail("v12 canonical decimal required")
  }
  let mut result = 0L
  for ch in text {
    guard ch >= '0' && ch <= '9' else {
      fail("v12 nonnegative decimal required")
    }
    let digit = (ch.to_int() - 48).to_int64()
    guard result <= (9223372036854775807L - digit) / 10L else {
      fail("v12 Int64 overflow")
    }
    result = result * 10L + digit
  }
  result
}

///|
fn v12_finite(profile : String) -> Bool raise {
  match profile {
    "measurement_only" => false
    "measurement_with_temporary_limit" | "explicit_enforced" => true
    _ => fail("unrecognized v12 budget profile")
  }
}

