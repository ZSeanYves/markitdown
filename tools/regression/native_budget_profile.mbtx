///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
}

///|
struct BenchCase {
  id : String
  format : String
  input : String
  bytes : Int64
  sha256 : String
}

///|
struct Report {
  evidence : String
  fingerprints : Array[String]
  samples : Array[String]
  values : Array[String]
  errors : Array[String]
  maxima : Map[String, Int64]
  witnesses : Map[String, String]
  policies : Map[String, Bool]
  mut accepted : Int32
  mut missing : Int32
  mut selected : Int32
  mut passed : Int32
  mut benchmark_measured : Int32
  mut quality_measured : Int32
  mut benchmark_failed : Int32
  mut quality_failed : Int32
  mut failed : Int32
  mut unavailable : Int32
  v12_samples : Array[String]
  v12_values : Array[String]
  v12_maxima : Map[String, Int64]
  v12_witnesses : Map[String, String]
  v12_groups : Map[String, Json]
  mut v12_external : Json?
  mut v12_binary_hash : String
  mut v12_tool_hash : String
  mut v12_source_hash : String
  mut v12_binary_path : String
  mut v12_observed : Int32
  mut v12_unavailable : Int32
  v13_samples : Array[String]
  v13_values : Array[String]
  v13_maxima : Map[String, Int64]
  v13_witnesses : Map[String, String]
  v13_groups : Map[String, Json]
  mut v13_external : Json?
  mut v13_binary_hash : String
  mut v13_tool_hash : String
  mut v13_source_hash : String
  mut v13_binary_path : String
  mut v13_observed : Int32
  mut v13_unavailable : Int32
}

///|
fn new_report(evidence : String) -> Report {
  {
    evidence,
    fingerprints: [],
    samples: [],
    values: [],
    errors: [],
    maxima: Map([]),
    witnesses: Map([]),
    policies: Map([]),
    accepted: 0,
    missing: 0,
    selected: 0,
    passed: 0,
    benchmark_measured: 0,
    quality_measured: 0,
    benchmark_failed: 0,
    quality_failed: 0,
    failed: 0,
    unavailable: 0,
    v12_samples: [],
    v12_values: [],
    v12_maxima: Map([]),
    v12_witnesses: Map([]),
    v12_groups: Map([]),
    v12_external: None,
    v12_binary_hash: "",
    v12_tool_hash: "",
    v12_source_hash: "",
    v12_binary_path: "",
    v12_observed: 0,
    v12_unavailable: 0,
    v13_samples: [],
    v13_values: [],
    v13_maxima: Map([]),
    v13_witnesses: Map([]),
    v13_groups: Map([]),
    v13_external: None,
    v13_binary_hash: "",
    v13_tool_hash: "",
    v13_source_hash: "",
    v13_binary_path: "",
    v13_observed: 0,
    v13_unavailable: 0,
  }
}

///|
fn counter_keys(schema : String) -> Array[String] raise {
  let result = [
    "budget_read_traffic_bytes", "budget_inflate_bytes", "budget_output_admitted_utf8_bytes",
    "budget_output_confirmed_utf8_bytes",
  ]
  match schema {
    "legacy_v1" =>
      result.append([
        "budget_zip_cache_payload_peak_bytes", "budget_zip_working_payload_peak_bytes",
      ])
    "partial_v2"
    | "partial_v3"
    | "partial_v4"
    | "partial_v5"
    | "partial_v6"
    | "partial_v7" =>
      result.append([
        "budget_cache_payload_peak_bytes", "budget_working_payload_peak_bytes", "budget_parse_work",
        "budget_source_metadata_bytes",
      ])
    "partial_v8" =>
      result.append([
        "budget_cache_payload_peak_bytes", "budget_working_payload_peak_bytes", "budget_parse_work",
        "budget_source_metadata_bytes",
      ])
    "partial_v9" =>
      result.append([
        "budget_cache_payload_peak_bytes", "budget_working_payload_peak_bytes", "budget_parse_work",
        "budget_source_metadata_bytes",
      ])
    "partial_v10" =>
      result.append([
        "budget_cache_payload_peak_bytes", "budget_working_payload_peak_bytes", "budget_parse_work",
        "budget_source_metadata_bytes",
      ])
    "partial_v11" =>
      result.append([
        "budget_cache_payload_peak_bytes", "budget_working_payload_peak_bytes", "budget_parse_work",
        "budget_source_metadata_bytes",
      ])
    _ => fail("unknown budget schema")
  }
  result
}

///|
fn budget_schema(value : Json) -> String raise {
  guard value is Object(fields) else { fail("missing budget usage object") }
  match fields.get("budget_schema") {
    None => "legacy_v1"
    Some(String("partial_v2")) => "partial_v2"
    Some(String("partial_v3")) => "partial_v3"
    Some(String("partial_v4")) => "partial_v4"
    Some(String("partial_v5")) => "partial_v5"
    Some(String("partial_v6")) => "partial_v6"
    Some(String("partial_v7")) => "partial_v7"
    Some(String("partial_v8")) => "partial_v8"
    Some(String("partial_v9")) => "partial_v9"
    Some(String("partial_v10")) => "partial_v10"
    Some(String("partial_v11")) => "partial_v11"
    Some(String("partial_v12")) => "partial_v12"
    Some(String("partial_v13")) => "partial_v13"
    _ => fail("unknown budget schema")
  }
}

