///|
fn v12_keys(profile : String) -> Array[String] raise {
  guard v12_get(v12_contract(v12_finite(profile)), "counter_fields")
    is Array(keys) else {
    fail("v12 counter keys required")
  }
  keys.map(v12_text)
}

///|
fn v12_scope(profile : String, dimension : String) -> String raise {
  v12_text(
    v12_get(
      v12_get(v12_contract(v12_finite(profile)), "measurement_scopes"),
      dimension,
    ),
  )
}

///|
fn v12_unit(dimension : String) -> String {
  if dimension == "budget_parse_work" {
    "modeled_parse_work_units"
  } else {
    "bytes"
  }
}

///|
fn v12_validate(value : Json) -> Unit raise {
  guard value is Object(fields) else { fail("v12 usage object required") }
  assert_eq(v12_get(value, "budget_schema"), Json("partial_v12"))
  let profile = v12_text(v12_get(value, "budget_profile"))
  let finite = v12_finite(profile)
  let policy = v12_contract(finite)
  assert_eq(fields.length(), if finite { 16 } else { 13 })
  for
    (field, policy_key) in [
      ("budget_coverage", "coverage"),
      ("budget_unmeasured", "unmeasured"),
      ("budget_resident_policy", "resident_policy"),
    ] {
    assert_eq(v12_get(value, field), v12_get(policy, policy_key))
  }
  for key in v12_keys(profile) {
    ignore(v12_nat(v12_get(value, key)))
  }
  assert_true(
    v12_nat(v12_get(value, "budget_output_confirmed_utf8_bytes")) <=
    v12_nat(v12_get(value, "budget_output_admitted_utf8_bytes")),
  )
  if finite {
    ignore(v12_nat(v12_get(value, "budget_temporary_limit_bytes")))
    assert_true(
      v12_nat(v12_get(value, "budget_temporary_current_bytes")) <=
      v12_nat(v12_get(value, "budget_temporary_payload_peak_bytes")),
    )
  }
}

///|
fn v12_fixture(profile : String, cap : String) -> Json raise {
  let policy = v12_contract(v12_finite(profile))
  let fields : Map[String, Json] = {
    "budget_schema": Json("partial_v12"),
    "budget_profile": Json(profile),
    "budget_coverage": v12_get(policy, "coverage"),
    "budget_unmeasured": v12_get(policy, "unmeasured"),
    "budget_resident_policy": v12_get(policy, "resident_policy"),
  }
  for key in v12_keys(profile) {
    fields[key] = Json("0")
  }
  if v12_finite(profile) {
    fields["budget_temporary_limit_bytes"] = Json(cap)
  }
  Json::object(fields)
}

///|
fn v12_policy_self_test() -> Unit raise {
  let none = v12_fixture("measurement_only", "unused")
  v12_validate(none)
  let finite = v12_fixture("measurement_with_temporary_limit", "100")
  v12_validate(finite)
  let historical = match finite {
    Object(fields) => fields.copy()
    _ => fail("object")
  }
  historical["budget_temporary_payload_peak_bytes"] = Json("200")
  historical["budget_temporary_current_bytes"] = Json("1")
  v12_validate(Json::object(historical))
  for
    profile in [
      "measurement_only", "measurement_with_temporary_limit", "explicit_enforced",
    ] {
    let original = v12_fixture(profile, "0")
    v12_validate(original)
    let keys = v12_keys(profile)
    assert_eq(keys.length(), if v12_finite(profile) { 10 } else { 8 })
    for key in keys {
      assert_true(v12_scope(profile, key) != "")
      assert_eq(
        v12_unit(key),
        if key == "budget_parse_work" {
          "modeled_parse_work_units"
        } else {
          "bytes"
        },
      )
      for
        bad in [
          Json(0),
          Json(-1),
          Json(1.5),
          Json(true),
          Json::null(),
          Json("-1"),
          Json("01"),
          Json("9223372036854775808"),
        ] {
        let changed = match original {
          Object(fields) => fields.copy()
          _ => fail("object")
        }
        changed[key] = bad
        assert_true(
          try {
            v12_validate(Json::object(changed))
            false
          } catch {
            _ => true
          },
        )
      }
    }
    for
      (key, bad) in [
        ("budget_schema", Json("partial_v11")),
        ("budget_coverage", Json("old")),
        ("budget_unmeasured", Json("none")),
        ("budget_resident_policy", Json("rss")),
        ("budget_profile", Json("unrecognized")),
      ] {
      let changed = match original {
        Object(fields) => fields.copy()
        _ => fail("object")
      }
      changed[key] = bad
      assert_true(
        try {
          v12_validate(Json::object(changed))
          false
        } catch {
          _ => true
        },
      )
    }
    let extra = match original {
      Object(fields) => fields.copy()
      _ => fail("object")
    }
    extra["unrecognized"] = Json("0")
    assert_true(
      try {
        v12_validate(Json::object(extra))
        false
      } catch {
        _ => true
      },
    )
  }
  for
    missing in [
      "pdf_loaded_objstm_decoded_text_parse_work", "pdf_loaded_objstm_decoded_text_logical_retention",
      "pptx_presentation_cursor_work", "pptx_presentation_cursor_workspace", "pptx_presentation_reference_string_metadata",
      "pptx_presentation_reference_retained_string_payload",
    ] {
    let changed = match none {
      Object(fields) => fields.copy()
      _ => fail("object")
    }
    changed["budget_coverage"] = Json(
      v12_text(changed["budget_coverage"]).replace_all(
        old=missing + ",",
        new="",
      ),
    )
    assert_true(
      try {
        v12_validate(Json::object(changed))
        false
      } catch {
        _ => true
      },
    )
  }
  for
    missing in [
      "jsonl_spool_codec_wire_work", "jsonl_spool_read_traffic", "jsonl_spool_temporary_payload",
      "jsonl_spool_codec_working", "jsonl_spool_event_utf16_payload",
    ] {
    let changed = match finite {
      Object(fields) => fields.copy()
      _ => fail("object")
    }
    let coverage = v12_text(changed["budget_coverage"])
    changed["budget_coverage"] = Json(
      if coverage.has_suffix(missing) {
        coverage.strip_suffix("," + missing).unwrap().to_owned()
      } else {
        coverage.replace_all(old=missing + ",", new="")
      },
    )
    assert_true(
      try {
        v12_validate(Json::object(changed))
        false
      } catch {
        _ => true
      },
    )
  }
  let wrong_current = historical.copy()
  wrong_current["budget_temporary_current_bytes"] = Json("201")
  assert_true(
    try {
      v12_validate(Json::object(wrong_current))
      false
    } catch {
      _ => true
    },
  )
}

///|
fn v12_canonical(value : Json) -> String {
  match value {
    Object(fields) => {
      let keys = fields.keys().to_array()
      keys.sort()
      "{" +
      keys
      .map(key => Json(key).stringify() + ":" + v12_canonical(fields[key]))
      .join(",") +
      "}"
    }
    Array(values) => "[" + values.map(v12_canonical).join(",") + "]"
    _ => value.stringify()
  }
}

///|
fn v12_hash(value : Json) -> String {
  digest(@utf8.encode(v12_canonical(value)))
}

///|
fn v12_limit_keys() -> Array[String] {
  [
    "inflate_bytes", "parse_work", "output_utf8_bytes", "source_metadata_bytes",
    "rag_metadata_bytes", "read_traffic_bytes", "cache_bytes", "working_bytes", "temporary_bytes",
    "ir_bytes",
  ]
}

///|
fn v12_limits(value : Json, enforced : Bool) -> Unit raise {
  guard value is Object(fields) else {
    fail("complete external limits object required")
  }
  assert_eq(fields.length(), 10)
  for key in v12_limit_keys() {
    let limit = v12_get(value, key)
    if limit == Json::null() {
      assert_false(enforced, msg="Enforced needs all ten finite limits")
    } else {
      ignore(v12_nat(limit))
    }
  }
}

///|
fn v12_context_for(
  report : Report,
  origin : String,
  id : String,
  view : String,
) -> Json raise {
  let external = report.v12_external.unwrap_or_else(() => {
    fail("missing external account-context evidence")
  })
  assert_eq(
    v12_get(external, "schema"),
    Json("markitdown_budget_v12_context_v1"),
  )
  for
    (key, value) in [
      ("binary_sha256", report.v12_binary_hash),
      ("tool_sha256", report.v12_tool_hash),
      ("source_archive_sha256", report.v12_source_hash),
    ] {
    assert_true(value.length() == 64, msg="missing bound identity")
    assert_eq(v12_get(external, key), Json(value))
  }
  if field(external, "sample_contexts") is Object(contexts) {
    if contexts.get(origin + "/" + id + "/" + view) is Some(context) {
      return context
    }
  }
  v12_get(external, "default_context")
}

///|
fn v12_cli_temporary(value : String) -> Json raise {
  let text = value.trim().to_owned()
  assert_true(text != "")
  let mut result = 0L
  for ch in text {
    assert_true(ch >= '0' && ch <= '9')
    let digit = (ch.to_int() - 48).to_int64()
    assert_true(result <= (9223372036854775807L - digit) / 10L)
    result = result * 10L + digit
  }
  Json(result.to_string())
}

///|
fn v12_command_options(
  report : Report,
  context : Json,
  command : Json,
  provenance : String,
) -> Json raise {
  let representation = v12_text(v12_get(context, "options_representation"))
  let declared = v12_get(context, "conversion_options")
  guard declared is Object(options) && options.length() > 0 else {
    fail("complete external conversion-options evidence required")
  }
  assert_eq(v12_get(context, "complete_options_evidence"), Json(true))
  let kind = v12_text(v12_get(declared, "input_kind"))
  assert_true(["Path", "Bytes", "Text", "Reader"].contains(kind))
  if representation == "explicit_convert_options_v1" {
    assert_true(options.contains("asset_demand"))
    return (
      {
        "schema": "explicit_convert_options_v1",
        "declared": declared,
        "requested_temporary_option": v12_get(
          context, "requested_temporary_option",
        ),
      } : Json)
  }
  assert_eq(representation, "frozen_cli_invocation_v1")
  assert_eq(kind, "Path")
  assert_eq(
    v12_get(declared, "defaults_source_archive_sha256"),
    Json(report.v12_source_hash),
  )
  assert_eq(v12_get(command, "program"), Json(report.v12_binary_path))
  guard v12_get(command, "args") is Array(raw) else {
    fail("CLI argument evidence required")
  }
  let args = raw.map(v12_text)
  assert_true(args.length() >= 3)
  assert_true(
    args[args.length() - 2] != "-",
    msg="stdin needs explicit input-kind evidence",
  )
  let normalized = args.copy()
  normalized[args.length() - 2] = "<input-data>"
  normalized[args.length() - 1] = "<output-data>"
  let mut requested : Json = Json::null()
  let mut assets = false
  let mut seen_provenance = false
  for index in 0..<(args.length() - 2) {
    if args[index] == "--provenance-out" {
      assert_false(seen_provenance)
      assert_true(index + 1 < args.length() - 2)
      assert_eq(args[index + 1], provenance)
      normalized[index + 1] = "<provenance-output>"
      seen_provenance = true
    }
    if args[index] == "--assets-dir" {
      assert_true(index + 1 < args.length() - 2)
      let own_directory = provenance
        .strip_suffix("/provenance.json")
        .unwrap_or_else(() => fail("unexpected provenance location"))
        .to_owned()
      if args[index + 1] == own_directory + "/assets" {
        normalized[index + 1] = "<assets-output>"
      }
      assets = true
    }
    if args[index] == "--max-temporary-bytes" {
      assert_true(index + 1 < args.length() - 2)
      requested = v12_cli_temporary(args[index + 1])
    }
    if args[index].has_prefix("--max-temporary-bytes=") {
      requested = v12_cli_temporary(
        args[index].strip_prefix("--max-temporary-bytes=").unwrap().to_owned(),
      )
    }
  }
  assert_true(seen_provenance)
  assert_eq(requested, v12_get(context, "requested_temporary_option"))
  let demand = if assets { "existing_output_assets" } else { "metadata_only" }
  if options.get("asset_demand") is Some(declared_demand) {
    assert_true(
      declared_demand == Json("from_frozen_cli_arguments") ||
      declared_demand == Json(demand),
    )
  }
  (
    {
      "schema": "frozen_cli_invocation_v1",
      "declared_defaults_and_input": declared,
      "exact_options_arguments_without_data_locations": Json(normalized),
      "asset_demand": Json(demand),
      "requested_temporary_option": requested,
      "source_archive_sha256": Json(report.v12_source_hash),
    } : Json)
}

///|
fn v12_group(
  report : Report,
  origin : String,
  id : String,
  format : String,
  mode : String,
  view : String,
  value : Json,
  command : Json,
  provenance : String,
) -> Json raise {
  let context = v12_context_for(report, origin, id, view)
  let profile = v12_text(v12_get(value, "budget_profile"))
  let finite = v12_finite(profile)
  let supplied = v12_get(context, "supplied_limits")
  let effective = v12_get(context, "effective_limits")
  let ledger_profile = v12_text(v12_get(context, "ledger_profile"))
  assert_true(["MeasurementOnly", "Enforced"].contains(ledger_profile))
  assert_eq(ledger_profile == "Enforced", profile == "explicit_enforced")
  v12_limits(supplied, ledger_profile == "Enforced")
  v12_limits(effective, ledger_profile == "Enforced")
  for key in v12_limit_keys() {
    let provided = v12_get(supplied, key)
    if provided != Json::null() {
      let actual = v12_get(effective, key)
      assert_true(
        actual != Json::null(),
        msg="supplied finite limit cannot become unbounded",
      )
      assert_true(
        v12_nat(actual) <= v12_nat(provided),
        msg="effective limit cannot loosen supplied limit",
      )
    }
  }
  let cap = if finite {
    v12_get(value, "budget_temporary_limit_bytes")
  } else {
    Json::null()
  }
  assert_eq(v12_get(effective, "temporary_bytes"), cap)
  let requested = v12_get(context, "requested_temporary_option")
  if requested != Json::null() {
    let requested_cap = v12_nat(requested)
    assert_true(finite)
    assert_true(v12_nat(cap) <= requested_cap)
  }
  let supplied_temporary = v12_get(supplied, "temporary_bytes")
  if supplied_temporary != Json::null() {
    let supplied_cap = v12_nat(supplied_temporary)
    assert_true(finite)
    assert_true(v12_nat(cap) <= supplied_cap)
  }
  let cohort = v12_text(v12_get(context, "origin_cohort"))
  assert_true(
    ["fresh_cli_owned", "fresh_public_owned", "borrowed_parent_ledger"].contains(
      cohort,
    ),
  )
  let usage_scope = v12_text(v12_get(context, "usage_scope"))
  assert_eq(
    usage_scope,
    if cohort == "borrowed_parent_ledger" {
      "ledger_lifetime"
    } else {
      "conversion_owned_lifetime"
    },
  )
  if finite && cohort == "fresh_cli_owned" {
    let controls = v12_get(context, "fresh_temporary_controls")
    for
      key in [
        "no_preexisting_temporary_history", "limit_installed_before_growth", "owned_cleanup_complete",
      ] {
      assert_eq(v12_get(controls, key), Json(true))
    }
    assert_true(
      v12_nat(v12_get(value, "budget_temporary_payload_peak_bytes")) <=
      v12_nat(cap),
    )
    assert_eq(v12_get(value, "budget_temporary_current_bytes"), Json("0"))
  }
  let options = v12_command_options(report, context, command, provenance)
  (
    {
      "schema": "partial_v12",
      "budget_profile": Json(profile),
      "effective_temporary_limit_bytes_or_None": if finite {
        cap
      } else {
        Json("None")
      },
      "origin_cohort": Json(cohort),
      "usage_scope": Json(usage_scope),
      "full_supplied_ledger_limits_fingerprint": Json(v12_hash(supplied)),
      "full_effective_ledger_limits_fingerprint": Json(v12_hash(effective)),
      "public_temporary_option_and_conversion_options_fingerprint": Json(
        v12_hash(options),
      ),
      "binary_sha256": Json(report.v12_binary_hash),
      "tool_sha256": Json(report.v12_tool_hash),
      "source_archive_sha256": Json(report.v12_source_hash),
      "format": Json(format),
      "mode": Json(mode),
      "view": Json(view),
      "evidence": {
        "supplied_limits": supplied,
        "effective_limits": effective,
        "options": options,
        "context": context,
      },
    } : Json)
}

///|
fn record_v12_sample(
  report : Report,
  origin : String,
  id : String,
  format : String,
  mode : String,
  view : String,
  value : Json,
  provenance : String,
  command : Json,
) -> Unit raise {
  v12_validate(value)
  assert_eq(
    v12_get(value, "budget_output_admitted_utf8_bytes"),
    v12_get(value, "budget_output_confirmed_utf8_bytes"),
  )
  assert_true(
    safe_id(format) &&
    safe_id(mode) &&
    ["markdown", "debug", "rag"].contains(view),
  )
  report.v12_observed += 1
  let grouped = Ok(
    v12_group(
      report, origin, id, format, mode, view, value, command, provenance,
    ),
  ) catch {
    error => Err(error.to_string())
  }
  let profile = v12_text(v12_get(value, "budget_profile"))
  let cap = if v12_finite(profile) {
    v12_text(v12_get(value, "budget_temporary_limit_bytes"))
  } else {
    "None"
  }
  let (group_id, status, reason) = match grouped {
    Ok(descriptor) => {
      let group_id = v12_hash(descriptor)
      if report.v12_groups.get(group_id) is Some(existing) {
        assert_eq(v12_canonical(existing), v12_canonical(descriptor))
      }
      report.v12_groups[group_id] = descriptor
      report.passed += 1
      if origin == "benchmark" {
        report.benchmark_measured += 1
      } else {
        report.quality_measured += 1
      }
      (group_id, "measured", "-")
    }
    Err(reason) => {
      report.v12_unavailable += 1
      ("-", "unavailable_context", clean(reason))
    }
  }
  report.policies["partial_v12\t" +
  profile +
  "\t" +
  v12_text(v12_get(value, "budget_coverage")) +
  "\t" +
  v12_text(v12_get(value, "budget_unmeasured")) +
  "\t" +
  v12_text(v12_get(value, "budget_resident_policy"))] = true
  report.v12_samples.push(
    origin +
    "\t" +
    id +
    "\t" +
    format +
    "\t" +
    mode +
    "\t" +
    view +
    "\t" +
    profile +
    "\t" +
    cap +
    "\t" +
    status +
    "\t" +
    group_id +
    "\t" +
    clean(provenance) +
    "\t" +
    reason,
  )
  for dimension in v12_keys(profile) {
    let count = v12_nat(v12_get(value, dimension))
    report.v12_values.push(
      origin +
      "\t" +
      id +
      "\t" +
      format +
      "\t" +
      mode +
      "\t" +
      view +
      "\t" +
      profile +
      "\t" +
      cap +
      "\t" +
      dimension +
      "\t" +
      count.to_string() +
      "\t" +
      v12_unit(dimension) +
      "\t" +
      v12_scope(profile, dimension) +
      "\t" +
      status +
      "\t" +
      group_id +
      "\t" +
      reason,
    )
    if status != "measured" {
      continue
    }
    for group_origin in [origin, "all"] {
      let key = group_id + "\t" + group_origin + "\t" + dimension
      if report.v12_maxima.get(key) is None || count > report.v12_maxima[key] {
        report.v12_maxima[key] = count
        report.v12_witnesses[key] = origin + "/" + id
      }
    }
  }
}

///|
async fn save_v12(report : Report) -> Unit {
  if report.v12_observed == 0 {
    return
  }
  let raw_header = "origin\tid\tformat\tmode\tview\tprofile\tcap\tdimension\tvalue\tunit\tmeasurement_scope\tstatus\tgroup_id\tcontext_reason"
  let sample_header = "origin\tid\tformat\tmode\tview\tprofile\tcap\tstatus\tgroup_id\tprovenance\tcontext_reason"
  @fs.write_file(
    report.evidence + "/v12-values-v1.tsv",
    raw_header + "\n" + report.v12_values.join("\n") + "\n",
  )
  @fs.write_file(
    report.evidence + "/v12-samples-v1.tsv",
    sample_header + "\n" + report.v12_samples.join("\n") + "\n",
  )
  let rows = [
    "group_id\torigin\tschema\tprofile\tcap\torigin_cohort\tsupplied_limits_fp\teffective_limits_fp\toptions_fp\tbinary_sha256\ttool_sha256\tsource_archive_sha256\tformat\tmode\tview\tusage_scope\tdimension\tmax\twitness\tunit\tmeasurement_scope",
  ]
  let keys = report.v12_maxima.keys().to_array()
  keys.sort()
  for key in keys {
    let parts = key.split("\t").to_array()
    assert_eq(parts.length(), 3)
    let group_id = parts[0].to_owned()
    let descriptor = report.v12_groups[group_id]
    let profile = v12_text(v12_get(descriptor, "budget_profile"))
    let dimension = parts[2].to_owned()
    let cells = [group_id, parts[1].to_owned(), "partial_v12", profile]
    for
      field in [
        "effective_temporary_limit_bytes_or_None", "origin_cohort", "full_supplied_ledger_limits_fingerprint",
        "full_effective_ledger_limits_fingerprint", "public_temporary_option_and_conversion_options_fingerprint",
        "binary_sha256", "tool_sha256", "source_archive_sha256", "format", "mode",
        "view", "usage_scope",
      ] {
      cells.push(v12_text(v12_get(descriptor, field)))
    }
    cells.append([
      dimension,
      report.v12_maxima[key].to_string(),
      report.v12_witnesses[key],
      v12_unit(dimension),
      v12_scope(profile, dimension),
    ])
    assert_eq(cells.length(), 21)
    rows.push(cells.join("\t"))
  }
  @fs.write_file(report.evidence + "/v12-maxima-v1.tsv", rows.join("\n") + "\n")
  @fs.write_file(
    report.evidence + "/v12-account-groups-v1.json",
    Json::object(report.v12_groups).stringify(indent=2) + "\n",
  )
  let summary : Json = {
    "table_schema": "markitdown_budget_v12_tables_v1",
    "canonical_json_schema": "key_sorted_json_preserve_number_repr_v1",
    "raw_observed": Json(report.v12_observed),
    "unavailable_context": Json(report.v12_unavailable),
    "usable": Json(report.v12_observed - report.v12_unavailable),
    "raw_counter_rows": Json(report.v12_values.length()),
    "account_groups": Json(report.v12_groups.length()),
    "maxima_rows": Json(report.v12_maxima.length()),
    "legacy_values_maxima_tables_exclude_v12": true,
    "all_maxima_are_exact_account_context_qualified": true,
    "performance_default_full_budget_acceptance": "not_established",
  }
  @fs.write_file(
    report.evidence + "/v12-table-schema-v1.json",
    summary.stringify(indent=2) + "\n",
  )
}

///|
fn v12_test_limits(temporary : Json, other : Json) -> Json {
  let result : Map[String, Json] = Map([])
  for key in v12_limit_keys() {
    result[key] = if key == "temporary_bytes" { temporary } else { other }
  }
  Json::object(result)
}

///|
fn v12_test_report() -> Report {
  let report = new_report("")
  report.v12_binary_hash = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  report.v12_tool_hash = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  report.v12_source_hash = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
  report.v12_binary_path = "/selftest/markitdown"
  report
}

///|
fn v12_test_context(
  report : Report,
  profile : String,
  cohort : String,
  supplied : Json,
  effective : Json,
  requested : Json,
) -> Json {
  let cli = cohort == "fresh_cli_owned"
  (
    {
      "origin_cohort": Json(cohort),
      "ledger_profile": Json(profile),
      "supplied_limits": supplied,
      "effective_limits": effective,
      "requested_temporary_option": requested,
      "options_representation": if cli {
        "frozen_cli_invocation_v1"
      } else {
        "explicit_convert_options_v1"
      },
      "complete_options_evidence": true,
      "usage_scope": if cohort == "borrowed_parent_ledger" {
        "ledger_lifetime"
      } else {
        "conversion_owned_lifetime"
      },
      "conversion_options": {
        "input_kind": if cli {
          "Path"
        } else {
          "Reader"
        },
        "asset_demand": "metadata_only",
        "defaults_source_archive_sha256": Json(report.v12_source_hash),
        "complete_options": {
          "convert_mode": "balanced",
          "output_mode": "debug",
          "temporary_option": requested,
        },
      },
      "fresh_temporary_controls": {
        "no_preexisting_temporary_history": true,
        "limit_installed_before_growth": true,
        "owned_cleanup_complete": true,
      },
    } : Json)
}

///|
fn v12_test_external(report : Report, context : Json) -> Json {
  (
    {
      "schema": "markitdown_budget_v12_context_v1",
      "binary_sha256": Json(report.v12_binary_hash),
      "tool_sha256": Json(report.v12_tool_hash),
      "source_archive_sha256": Json(report.v12_source_hash),
      "default_context": context,
      "sample_contexts": {},
    } : Json)
}

///|
fn v12_test_command(report : Report, cap : Json) -> Json {
  let args = [
    "balance", "--debug", "--format", "jsonl", "--provenance-out", "/selftest/provenance.json",
  ]
  if cap != Json::null() {
    args.append([
      "--max-temporary-bytes",
      v12_text(cap) catch {
        _ => "invalid"
      },
    ])
  }
  args.append(["/input", "/output"])
  ({ "program": Json(report.v12_binary_path), "args": Json(args) } : Json)
}

///|
fn v12_account_self_test() -> Unit raise {
  let none = v12_fixture("measurement_only", "unused")
  let missing = v12_test_report()
  record_v12_sample(
    missing,
    "benchmark",
    "missing",
    "jsonl",
    "balanced",
    "debug",
    none,
    "/selftest/provenance.json",
    v12_test_command(missing, Json::null()),
  )
  assert_eq(missing.v12_observed, 1)
  assert_eq(missing.v12_unavailable, 1)
  assert_eq(missing.v12_values.length(), 8)
  assert_eq(missing.v12_maxima.length(), 0)
  assert_eq(missing.passed, 0)
  assert_eq(missing.unavailable, 0) // only expected rejects use this legacy counter

  let good = v12_test_report()
  let fresh = v12_test_context(
    good,
    "MeasurementOnly",
    "fresh_cli_owned",
    v12_test_limits(Json::null(), Json::null()),
    v12_test_limits(Json::null(), Json::null()),
    Json::null(),
  )
  good.v12_external = Some(v12_test_external(good, fresh))
  record_v12_sample(
    good,
    "benchmark",
    "good",
    "jsonl",
    "balanced",
    "debug",
    none,
    "/selftest/provenance.json",
    v12_test_command(good, Json::null()),
  )
  assert_eq(good.passed, 1)
  assert_eq(good.v12_groups.length(), 1)
  assert_eq(good.v12_maxima.length(), 16)

  let inherited = v12_test_report()
  let historical = match
    v12_fixture("measurement_with_temporary_limit", "100") {
    Object(fields) => fields.copy()
    _ => fail("object")
  }
  historical["budget_temporary_payload_peak_bytes"] = Json("200")
  historical["budget_temporary_current_bytes"] = Json("1")
  let supplied = match v12_test_limits(Json("200"), Json::null()) {
    Object(fields) => fields.copy()
    _ => fail("object")
  }
  supplied["working_bytes"] = Json("100")
  let first = match v12_test_limits(Json("100"), Json::null()) {
    Object(fields) => fields.copy()
    _ => fail("object")
  }
  first["working_bytes"] = Json("64")
  for (id, working) in [("one", "64"), ("two", "32")] {
    first["working_bytes"] = Json(working)
    let context = v12_test_context(
      inherited,
      "MeasurementOnly",
      "borrowed_parent_ledger",
      Json::object(supplied.copy()),
      Json::object(first.copy()),
      Json::null(),
    )
    inherited.v12_external = Some(v12_test_external(inherited, context))
    record_v12_sample(
      inherited,
      "quality",
      id,
      "jsonl",
      "balanced",
      "debug",
      Json::object(historical.copy()),
      "/selftest/provenance.json",
      v12_test_command(inherited, Json::null()),
    )
  }
  assert_eq(inherited.passed, 2)
  assert_eq(inherited.v12_groups.length(), 2)
  assert_eq(inherited.v12_maxima.length(), 40)
  let effective_seen : Map[String, Bool] = Map([])
  for _, descriptor in inherited.v12_groups {
    effective_seen[v12_text(
      v12_get(descriptor, "full_effective_ledger_limits_fingerprint"),
    )] = true
  }
  assert_eq(effective_seen.length(), 2)

  let bad_enforced = v12_test_report()
  let partial = v12_test_context(
    bad_enforced,
    "Enforced",
    "borrowed_parent_ledger",
    v12_test_limits(Json("200"), Json::null()),
    v12_test_limits(Json("100"), Json::null()),
    Json::null(),
  )
  bad_enforced.v12_external = Some(v12_test_external(bad_enforced, partial))
  record_v12_sample(
    bad_enforced,
    "quality",
    "incomplete-enforced",
    "jsonl",
    "balanced",
    "debug",
    v12_fixture("explicit_enforced", "100"),
    "/selftest/provenance.json",
    v12_test_command(bad_enforced, Json::null()),
  )
  assert_eq(bad_enforced.v12_unavailable, 1)
  assert_eq(bad_enforced.v12_maxima.length(), 0)
  let full_enforced = v12_test_report()
  let full = v12_test_context(
    full_enforced,
    "Enforced",
    "borrowed_parent_ledger",
    v12_test_limits(Json("200"), Json("200")),
    v12_test_limits(Json("100"), Json("200")),
    Json::null(),
  )
  full_enforced.v12_external = Some(v12_test_external(full_enforced, full))
  let enforced = historical.copy()
  enforced["budget_profile"] = Json("explicit_enforced")
  record_v12_sample(
    full_enforced,
    "quality",
    "full-enforced",
    "jsonl",
    "balanced",
    "debug",
    Json::object(enforced),
    "/selftest/provenance.json",
    v12_test_command(full_enforced, Json::null()),
  )
  assert_eq(full_enforced.passed, 1)
  assert_eq(full_enforced.v12_maxima.length(), 20)

  let fresh_violation = v12_test_report()
  let fresh_finite = v12_test_context(
    fresh_violation,
    "MeasurementOnly",
    "fresh_cli_owned",
    v12_test_limits(Json::null(), Json::null()),
    v12_test_limits(Json("100"), Json::null()),
    Json("100"),
  )
  fresh_violation.v12_external = Some(
    v12_test_external(fresh_violation, fresh_finite),
  )
  record_v12_sample(
    fresh_violation,
    "quality",
    "fresh-violation",
    "jsonl",
    "balanced",
    "debug",
    Json::object(historical.copy()),
    "/selftest/provenance.json",
    v12_test_command(fresh_violation, Json("100")),
  )
  assert_eq(fresh_violation.v12_unavailable, 1)
  assert_eq(fresh_violation.v12_maxima.length(), 0)
  assert_eq(v12_cli_temporary("0003"), Json("3"))
  assert_eq(v12_cli_temporary(" 3 "), Json("3"))
  assert_true(
    try {
      ignore(v12_cli_temporary("9223372036854775808"))
      false
    } catch {
      _ => true
    },
  )

  for
    missing_key in [
      "origin_cohort", "supplied_limits", "effective_limits", "conversion_options",
      "complete_options_evidence",
    ] {
    let report = v12_test_report()
    let fields = match fresh {
      Object(fields) => fields.copy()
      _ => fail("object")
    }
    fields.remove(missing_key)
    report.v12_external = Some(v12_test_external(report, Json::object(fields)))
    record_v12_sample(
      report,
      "benchmark",
      "missing-" + missing_key,
      "jsonl",
      "balanced",
      "debug",
      none,
      "/selftest/provenance.json",
      v12_test_command(report, Json::null()),
    )
    assert_eq(report.v12_unavailable, 1)
    assert_eq(report.v12_maxima.length(), 0)
  }
  let groups = v12_test_report()
  groups.v12_external = Some(v12_test_external(groups, fresh))
  for
    (mode, view) in [
      ("balanced", "debug"),
      ("accurate", "debug"),
      ("balanced", "rag"),
    ] {
    record_v12_sample(
      groups,
      "benchmark",
      mode + "-" + view,
      "jsonl",
      mode,
      view,
      none,
      "/selftest/provenance.json",
      v12_test_command(groups, Json::null()),
    )
  }
  assert_eq(groups.v12_groups.length(), 3)
  assert_eq(groups.v12_maxima.length(), 48)

  let varied = v12_test_report()
  for cap in ["100", "200"] {
    let context = v12_test_context(
      varied,
      "MeasurementOnly",
      "borrowed_parent_ledger",
      v12_test_limits(Json("200"), Json::null()),
      v12_test_limits(Json(cap), Json::null()),
      Json::null(),
    )
    varied.v12_external = Some(v12_test_external(varied, context))
    record_v12_sample(
      varied,
      "quality",
      "cap-" + cap,
      "jsonl",
      "balanced",
      "debug",
      v12_fixture("measurement_with_temporary_limit", cap),
      "/selftest/provenance.json",
      v12_test_command(varied, Json::null()),
    )
  }
  assert_eq(varied.v12_groups.length(), 2)
  assert_eq(varied.v12_maxima.length(), 40)
  let changed = match fresh {
    Object(fields) => fields.copy()
    _ => fail("object")
  }
  let opts = match changed["conversion_options"] {
    Object(fields) => fields.copy()
    _ => fail("object")
  }
  opts["unregistered_dropping_options_is_forbidden"] = Json("retained")
  changed["conversion_options"] = Json::object(opts)
  good.v12_external = Some(v12_test_external(good, Json::object(changed)))
  record_v12_sample(
    good,
    "benchmark",
    "different-options",
    "jsonl",
    "balanced",
    "debug",
    none,
    "/selftest/provenance.json",
    v12_test_command(good, Json::null()),
  )
  assert_eq(good.v12_groups.length(), 2)

  let flag_context = v12_test_context(
    good,
    "MeasurementOnly",
    "fresh_cli_owned",
    v12_test_limits(Json::null(), Json::null()),
    v12_test_limits(Json("3"), Json::null()),
    Json("3"),
  )
  let repeat : Json = {
    "program": Json(good.v12_binary_path),
    "args": [
      "balance", "--max-temporary-bytes", "9", "--max-temporary-bytes=0003", "--provenance-out",
      "/selftest/provenance.json", "/input", "/output",
    ],
  }
  let exact = v12_command_options(
    good, flag_context, repeat, "/selftest/provenance.json",
  )
  assert_eq(v12_get(exact, "requested_temporary_option"), Json("3"))
  let supplied_loosened = v12_test_context(
    good,
    "MeasurementOnly",
    "borrowed_parent_ledger",
    v12_test_limits(Json("100"), Json("1")),
    v12_test_limits(Json("100"), Json("2")),
    Json::null(),
  )
  good.v12_external = Some(v12_test_external(good, supplied_loosened))
  assert_true(
    try {
      ignore(
        v12_group(
          good,
          "quality",
          "loosened",
          "jsonl",
          "balanced",
          "debug",
          v12_fixture("measurement_with_temporary_limit", "100"),
          v12_test_command(good, Json::null()),
          "/selftest/provenance.json",
        ),
      )
      false
    } catch {
      _ => true
    },
  )
}

///|
fn v13_get(value : Json, key : String) -> Json raise {
  guard value is Object(fields) else { fail("v13 object required") }
  fields.get(key).unwrap_or_else(() => fail("v13 missing field: " + key))
}

///|
fn v13_text(value : Json) -> String raise {
  guard value is String(text) else { fail("v13 JSON string required") }
  text
}

///|
fn v13_nat(value : Json) -> Int64 raise {
  let text = v13_text(value)
  guard text != "" && (text == "0" || text[0] != '0') else {
    fail("v13 canonical decimal required")
  }
  let mut result = 0L
  for ch in text {
    guard ch >= '0' && ch <= '9' else {
      fail("v13 nonnegative decimal required")
    }
    let digit = (ch.to_int() - 48).to_int64()
    guard result <= (9223372036854775807L - digit) / 10L else {
      fail("v13 Int64 overflow")
    }
    result = result * 10L + digit
  }
  result
}

///|
fn v13_finite(profile : String) -> Bool raise {
  match profile {
    "measurement_only" => false
    "measurement_with_temporary_limit" | "explicit_enforced" => true
    _ => fail("unrecognized v13 budget profile")
  }
}

