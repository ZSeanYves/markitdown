    "modeled_parse_work_units",
  )
  assert_eq(
    measurement_scope("partial_v9", "budget_parse_work"),
    measurement_scope("partial_v8", "budget_parse_work"),
  )
  assert_eq(
    measurement_scope("partial_v9", "budget_source_metadata_bytes"),
    "ooxml_content_types_relationships_row_index_selected_core_app_custom_name_type_value_and_docx_paragraph_escaping_string_utf8_payload_only;other_source_metadata_unmeasured",
  )
  assert_eq(counter_unit("partial_v9", "budget_source_metadata_bytes"), "bytes")
  assert_eq(
    measurement_scope("partial_v9", "budget_source_metadata_bytes"),
    measurement_scope("partial_v8", "budget_source_metadata_bytes"),
  )
  assert_eq(
    measurement_scope("partial_v9", "budget_cache_payload_peak_bytes"),
    "zip_ooxml_content_types_relationships_core_app_custom_docx_paragraph_escaping_strings_pdf_probe_indexed_dictionary_range_object_stream_cli_source_asset_and_ranged_font_program_and_ranged_local_cmap_postparse_native64_selected_fields_slots_strings_retained_payload_upper_bound;allocator_outer_cmap_map_bookkeeping_parse_merge_and_other_cache_unmeasured",
  )
  assert_eq(
    counter_unit("partial_v9", "budget_cache_payload_peak_bytes"),
    "bytes",
  )
  assert_eq(
    measurement_scope("partial_v9", "budget_working_payload_peak_bytes"),
    "zip_ooxml_content_types_relationships_core_app_custom_namespace_and_scalar_buffers_docx_paragraph_utf8_feed_token_fields_and_raw_inline_ranges_pdf_flate_indexed_stream_range_pending_image_descriptor_refbuffer_and_scope_name_utf16_cli_source_asset_collection_bounded_read_payload_modeled_scratch_upper_bound;other_working_unmeasured",
  )
  assert_eq(
    counter_unit("partial_v9", "budget_working_payload_peak_bytes"),
    "bytes",
  )
  assert_eq(
    measurement_scope("partial_v9", "budget_working_payload_peak_bytes"),
    measurement_scope("partial_v8", "budget_working_payload_peak_bytes"),
  )
  assert_true(
    measurement_scope("partial_v9", "budget_cache_payload_peak_bytes") !=
    measurement_scope("partial_v8", "budget_cache_payload_peak_bytes"),
  )
  assert_eq(
    measurement_scope("partial_v9", "unknown"),
    "unmeasured_unknown_dimension",
  )
  let expected_scopes : Map[String, String] = {
    "budget_read_traffic_bytes": "input_read_view_memory_payload_and_cli_admitted_opened_source_asset_read_traffic",
    "budget_inflate_bytes": "zip_and_pdf_flate_output_only;other_inflate_and_pdf_non_flate_unmeasured",
    "budget_output_admitted_utf8_bytes": "output_write_admission",
    "budget_output_confirmed_utf8_bytes": "confirmed_successful_output_writes",
    "budget_parse_work": "ooxml_cursor_utf8_selected_core_app_docx_paragraph_with_synthetic_roots_and_emitted_custom_serialized_scalars_yaml_logical_nodes_merge_copies_pdf_probe_bytes_code_units_entries_visits_comparisons_and_object_stream_code_units;other_parse_work_unmeasured",
    "budget_source_metadata_bytes": "ooxml_content_types_relationships_row_index_selected_core_app_custom_name_type_value_and_docx_paragraph_escaping_string_utf8_payload_only;other_source_metadata_unmeasured",
    "budget_cache_payload_peak_bytes": "zip_ooxml_content_types_relationships_core_app_custom_docx_paragraph_escaping_strings_pdf_probe_indexed_dictionary_range_object_stream_cli_source_asset_and_ranged_font_program_and_ranged_local_cmap_postparse_native64_selected_fields_slots_strings_retained_payload_upper_bound;allocator_outer_cmap_map_bookkeeping_parse_merge_and_other_cache_unmeasured",
    "budget_working_payload_peak_bytes": "zip_ooxml_content_types_relationships_core_app_custom_namespace_and_scalar_buffers_docx_paragraph_utf8_feed_token_fields_and_raw_inline_ranges_pdf_flate_indexed_stream_range_pending_image_descriptor_refbuffer_and_scope_name_utf16_cli_source_asset_collection_bounded_read_payload_modeled_scratch_upper_bound;other_working_unmeasured",
  }
  let valid_scope_row = fn(row : String) {
    let columns = row.split("\t").to_array()
    columns.length() == 10 &&
    columns[1] == "partial_v9" &&
    expected_scopes.get(columns[6].to_owned()) == Some(columns[9].to_owned())
  }
  let v9_rows = report.values.filter(row => {
    row.split("\t").to_array()[1] == "partial_v9"
  })
  assert_eq(v9_rows.length(), 16)
  for row in v9_rows {
    assert_true(valid_scope_row(row))
  }
  let cache_rows = v9_rows.filter(row => {
    row.split("\t").to_array()[6] == "budget_cache_payload_peak_bytes"
  })
  assert_eq(cache_rows.length(), 2)
  for row in cache_rows {
    let columns = row.split("\t").map(value => value.to_owned()).to_array()
    columns[9] = measurement_scope(
      "partial_v8", "budget_cache_payload_peak_bytes",
    )
    assert_false(valid_scope_row(columns.join("\t")))
    columns[9] = "all_cache_and_rss_complete"
    assert_false(valid_scope_row(columns.join("\t")))
  }
}

///|
fn self_test_v10_budget_policy() -> Unit raise {
  let fields = self_test_profile_fields("partial_v10", "measurement_only")
  let wrap = fn() {
    Json::object({ "budget_usage": Json::object(fields) }).stringify()
  }
  let rejects = fn(value : String) {
    try {
      ignore(profile(value))
      false
    } catch {
      _ => true
    }
  }
  assert_eq(fields.length(), 13)
  assert_eq(counter_keys("partial_v10"), counter_keys("partial_v9"))
  assert_eq(counter_keys("partial_v10").length(), 8)
  assert_eq(
    accounting_policy("partial_v10").1,
    accounting_policy("partial_v9").1,
  )
  ignore(profile(wrap()))
  fields["budget_schema"] = Json("partial_v9")
  assert_true(rejects(wrap()))
  fields["budget_schema"] = Json("partial_v10")
  fields["budget_coverage"] = Json(accounting_policy("partial_v9").0)
  assert_true(rejects(wrap()))
  fields["budget_coverage"] = Json(accounting_policy("partial_v10").0)
  for dimension in counter_keys("partial_v10") {
    for
      bad in [
        Json(0),
        Json(-1),
        Json(1.5),
        Json(true),
        Json::null(),
        Json("-1"),
        Json("01"),
        Json("9223372036854775808"),
      ] {
      fields[dimension] = bad
      assert_true(rejects(wrap()))
    }
    fields[dimension] = Json("0")
  }
  fields["pdf_font_local_result_cache_bytes"] = Json("1")
  assert_true(rejects(wrap()))
  fields.remove("pdf_font_local_result_cache_bytes")
  fields["budget_profile"] = Json("explicit_enforced")
  ignore(profile(wrap()))
  fields["budget_resident_policy"] = Json("rss_bound")
  assert_true(rejects(wrap()))
  fields["budget_resident_policy"] = Json("scope_retained_payload_upper_bound")
  let report = new_report("")
  for
    (schema, account_profile, count) in [
      ("partial_v9", "measurement_only", 113L),
      ("partial_v9", "explicit_enforced", 127L),
      ("partial_v10", "measurement_only", 131L),
      ("partial_v10", "explicit_enforced", 137L),
    ] {
    let row = self_test_profile_fields(schema, account_profile)
    row["budget_cache_payload_peak_bytes"] = Json(count.to_string())
    record_sample(
      report,
      "benchmark",
      schema + account_profile,
      "pdf",
      "debug",
      profile(Json::object({ "budget_usage": Json::object(row) }).stringify()),
      "selftest",
    )
    assert_eq(
      report.maxima["all\t" +
      schema +
      "\t" +
      account_profile +
      "\t*\t*\tbudget_cache_payload_peak_bytes"],
      count,
    )
  }
  assert_eq(
    report.maxima["all\tpartial_v9\tmeasurement_only\t*\t*\tbudget_cache_payload_peak_bytes"],
    113L,
  )
  assert_eq(
    report.maxima["all\tpartial_v9\texplicit_enforced\t*\t*\tbudget_cache_payload_peak_bytes"],
    127L,
  )
  assert_eq(
    measurement_scope("partial_v10", "budget_read_traffic_bytes"),
    "input_read_view_memory_payload_and_cli_admitted_opened_source_asset_read_traffic",
  )
  assert_eq(counter_unit("partial_v10", "budget_read_traffic_bytes"), "bytes")
  assert_eq(
    measurement_scope("partial_v10", "budget_read_traffic_bytes"),
    measurement_scope("partial_v9", "budget_read_traffic_bytes"),
  )
  assert_eq(
    measurement_scope("partial_v10", "budget_inflate_bytes"),
    "zip_and_pdf_flate_output_only;other_inflate_and_pdf_non_flate_unmeasured",
  )
  assert_eq(counter_unit("partial_v10", "budget_inflate_bytes"), "bytes")
  assert_eq(
    measurement_scope("partial_v10", "budget_inflate_bytes"),
    measurement_scope("partial_v9", "budget_inflate_bytes"),
  )
  assert_eq(
    measurement_scope("partial_v10", "budget_output_admitted_utf8_bytes"),
    "output_write_admission",
  )
  assert_eq(
    counter_unit("partial_v10", "budget_output_admitted_utf8_bytes"),
    "bytes",
  )
  assert_eq(
    measurement_scope("partial_v10", "budget_output_admitted_utf8_bytes"),
    measurement_scope("partial_v9", "budget_output_admitted_utf8_bytes"),
  )
  assert_eq(
