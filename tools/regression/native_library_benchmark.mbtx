///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
}

///|
struct LibraryCase {
  id : String
  input : String
  input_sha256 : String
  source_name : String
  input_kind : String
  format : String
  mode : String
  view : String
  limits : Map[String, String]
  rag : Map[String, Json]
  asset_demand : String
} derive(FromJson, ToJson)

///|
struct ProcessMetrics {
  wall_ms : Double?
  cpu_ms : Double?
  peak_rss_bytes : Double?
} derive(ToJson, FromJson)

///|
struct Slot {
  phase : String
  iteration : Int32
  lane : String
} derive(ToJson, FromJson, Eq, Debug)

///|
fn object(value : Json) -> Map[String, Json] raise {
  match value {
    Object(fields) => fields
    _ => fail("JSON object required")
  }
}

///|
fn field(value : Json, key : String) -> Json raise {
  object(value).get(key).unwrap_or_else(() => fail("missing field: " + key))
}

///|
fn text(value : Json) -> String raise {
  match value {
    String(value) => value
    _ => fail("JSON string required")
  }
}

///|
fn count(value : Json) -> Int32 raise {
  @json.from_json(value)
}

///|
fn valid_number(value : Double) -> Bool {
  !value.is_nan() && !value.is_inf() && value >= 0.0
}

///|
fn number(value : String) -> Double? {
  let result = @string.parse_double(value.trim()) catch { _ => return None }
  if valid_number(result) {
    Some(result)
  } else {
    None
  }
}

///|
fn safe_id(value : String) -> Bool {
  value != "" &&
  value != "." &&
  value != ".." &&
  value
  .iter()
  .all(ch => {
    (ch >= 'a' && ch <= 'z') ||
    (ch >= 'A' && ch <= 'Z') ||
    (ch >= '0' && ch <= '9') ||
    ch == '-' ||
    ch == '_' ||
    ch == '.'
  })
}

///|
fn hash_bytes(value : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(value))
}

///|
async fn hash_file(path : String) -> String {
  hash_bytes(@fs.read_file(path).binary())
}

///|
async fn read_json(path : String) -> Json {
  @json.parse(@fs.read_file(path).text(), reject_duplicate_keys=true)
}

///|
async fn write_json(path : String, value : Json) -> Unit {
  @fs.write_file(path, value.stringify(indent=2) + "\n")
}

///|
async fn fresh(path : String) -> Unit {
  guard path.has_prefix("/") && !@fs.exists(path) else {
    fail("fresh absolute evidence directory required")
  }
  @fs.mkdir(path, recursive=true)
}

///|
fn exact_keys(value : Json, keys : Array[String]) -> Bool {
  guard value is Object(fields) else { return false }
  fields.length() == keys.length() && keys.all(key => fields.contains(key))
}

///|
fn case_valid(value : Json) -> Bool {
  if !exact_keys(value, [
      "id", "input", "input_sha256", "source_name", "input_kind", "format", "mode",
      "view", "limits", "rag", "asset_demand",
    ]) {
    return false
  }
  let item : LibraryCase = @json.from_json(value) catch { _ => return false }
  if !safe_id(item.id) ||
    !item.input.has_prefix("/") ||
    item.source_name == "" ||
    item.input_sha256.length() != 64 ||
    !item.input_sha256
    .iter()
    .all(ch => (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f')) ||
    !["path", "text", "bytes", "reader", "async_reader"].contains(
      item.input_kind,
    ) ||
    !["balanced", "accurate", "stream"].contains(item.mode) ||
    !["markdown", "debug", "rag"].contains(item.view) ||
    item.asset_demand != "public_metadata_only" {
    return false
  }
  let limit_keys = [
    "max_rows", "max_cols", "max_cells", "max_line_chars", "max_input_bytes", "max_asset_bytes",
    "max_total_asset_bytes",
  ]
  if item.limits.length() != 7 {
    return false
  }
  for key in limit_keys {
    let raw = item.limits.get(key).unwrap_or("")
    if raw == "" || !raw.iter().all(ch => ch >= '0' && ch <= '9') {
      return false
    }
    let value = @string.parse_int64(raw) catch { _ => return false }
    if value < 0L ||
      (
        ["max_rows", "max_cols", "max_cells", "max_line_chars"].contains(key) &&
        value > 2147483647L
      ) {
      return false
    }
  }
  let rag = Json::object(item.rag)
  if !exact_keys(rag, [
      "chunk_size", "chunk_overlap", "preserve_heading_path", "preserve_source_ref",
      "split_tables", "split_code_blocks",
    ]) {
    return false
  }
  let size : Int32 = @json.from_json(item.rag["chunk_size"]) catch {
    _ => return false
  }
  let overlap : Int32 = @json.from_json(item.rag["chunk_overlap"]) catch {
    _ => return false
  }
  if size <= 0 || overlap < 0 || overlap >= size {
    return false
  }
  for
    key in [
      "preserve_heading_path", "preserve_source_ref", "split_tables", "split_code_blocks",
    ] {
    let _ : Bool = @json.from_json(item.rag[key]) catch { _ => return false }
  }
  true
}

///|
fn schedule(window : Int32) -> Array[Slot] {
  let result : Array[Slot] = []
  for round in 1..<=3 {
    let lanes = if (round + window) % 2 == 0 {
      ["baseline", "candidate"]
    } else {
      ["candidate", "baseline"]
    }
    for lane in lanes {
      result.push({ phase: "warmup", iteration: round, lane, })
    }
  }
  for quartet in 0..<15 {
    let lanes = if window == 1 {
      ["baseline", "candidate", "candidate", "baseline"]
    } else {
      ["candidate", "baseline", "baseline", "candidate"]
    }
    let seen : Map[String, Int32] = Map([])
    for lane in lanes {
      let next = seen.get(lane).unwrap_or(0) + 1
      seen[lane] = next
      result.push({ phase: "measure", iteration: quartet * 2 + next, lane, })
    }
  }
  result
}

///|
fn percentile(values : Array[Double], fraction : Double) -> Double? {
  if values.is_empty() {
    return None
  }
  let sorted = values.copy()
  sorted.sort()
  let rank = (fraction * sorted.length().to_double()).ceil().to_int().max(1)
  Some(sorted[rank - 1])
}

///|
fn process_metrics(raw : String, platform : String) -> ProcessMetrics {
  let mut wall = None
  let mut user = None
  let mut system = None
  let mut rss = None
  for line in raw.split("\n") {
    let line = line.trim().to_owned()
    if platform == "Darwin" {
      let words = line.split(" ").filter(part => part != "").to_array()
      for index in 1..<words.length() {
        match words[index] {
          "real" =>
            wall = number(words[index - 1].to_owned()).map(value => {
              value * 1000.0
            })
          "user" =>
            user = number(words[index - 1].to_owned()).map(value => {
              value * 1000.0
            })
          "sys" =>
            system = number(words[index - 1].to_owned()).map(value => {
              value * 1000.0
            })
          _ => ()
        }
      }
      if line.has_suffix("maximum resident set size") && !words.is_empty() {
        rss = number(words[0].to_owned())
      }
    } else {
      for
        pair in [
          ("User time (seconds):", "user"),
          ("System time (seconds):", "system"),
          ("Elapsed (wall clock) time (h:mm:ss or m:ss):", "wall"),
          ("Maximum resident set size (kbytes):", "rss"),
        ] {
        let (label, kind) = pair
        if !line.has_prefix(label) {
          continue
        }
        let value = line[label.length():].trim().to_owned()
        match kind {
          "user" => user = number(value).map(value => value * 1000.0)
          "system" => system = number(value).map(value => value * 1000.0)
          "rss" => rss = number(value).map(value => value * 1024.0)
          "wall" => {
            let mut seconds = 0.0
            let mut valid = true
            for part in value.split(":") {
              match number(part.to_owned()) {
                Some(value) => seconds = seconds * 60.0 + value
                None => valid = false
              }
            }
            if valid {
              wall = Some(seconds * 1000.0)
            }
          }
          _ => ()
        }
      }
    }
  }
  let cpu = match (user, system) {
    (Some(a), Some(b)) => Some(a + b)
    _ => None
  }
  { wall_ms: wall, cpu_ms: cpu, peak_rss_bytes: rss, }
}

