import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
}

async fn run_step(root : String, output_dir : String, label : String, log_name : String, args : Array[String]) -> Unit {
  println("coverage: " + label)
  let result = @shell.Cmd("moon", args, cwd=root).output()
  let log = result.stdout() + "\n" + result.stderr()
  @fs.write_file(output_dir + "/" + log_name, log)
  if result.exit_code() != 0 {
    println("coverage: failed while " + label + " (exit=" + result.exit_code().to_string() + ")")
    println("coverage: log: " + output_dir + "/" + log_name)
    println(result.stderr())
    if label == "checking coverage thresholds" && @fs.exists(output_dir + "/coverage.md") {
      println(@fs.read_file(output_dir + "/coverage.md").text())
    }
    fail("coverage step failed")
  }
}

async fn main {
  let args = @env.args()
  let mut enforce = false
  if args.length() > 1 {
    if args.length() == 2 && args[1] == "--enforce" {
      enforce = true
    } else if args.length() == 2 && args[1] == "--self-test" {
      @shell.Cmd("moon", ["run", "tools/regression/coverage_gate.mbtx", "--self-test"], cwd=@env.current_dir().unwrap_or(".")).run()
      return
    } else {
      fail("usage: check_coverage.mbtx [--enforce|--self-test]")
    }
  }
  let root = @env.current_dir().unwrap_or(".")
  let output_dir = @env.get_env_var("MARKITDOWN_COVERAGE_OUTPUT_DIR").unwrap_or(root + "/.tmp/coverage")
  @fs.mkdir(output_dir, recursive=true, allow_exist=true)
  run_step(root, output_dir, "cleaning coverage data", "coverage-clean.log", ["coverage", "clean"])
  run_step(root, output_dir, "running tests with coverage", "coverage-test.log", ["test", "--enable-coverage"])
  run_step(root, output_dir, "analyzing uncovered code", "uncovered.log", ["coverage", "analyze"])
  let cobertura = output_dir + "/cobertura.xml"
  run_step(root, output_dir, "generating Cobertura report", "coverage-report.log", ["coverage", "report", "-f", "cobertura", "-o", cobertura])
  let baseline = root + "/tools/regression/coverage-baseline.json"
  let baseline_ref = @env.get_env_var("MARKITDOWN_COVERAGE_BASELINE_REF")
  let reference = match baseline_ref {
    Some(value) if value == "0000000000000000000000000000000000000000" => Some("HEAD^")
    other => other
  }
  let gate_args : Array[String] = [
    "run", "tools/regression/coverage_gate.mbtx",
    "--cobertura", cobertura,
    "--output-dir", output_dir,
    "--baseline", baseline,
  ]
  match reference {
    Some(value) => {
      gate_args.push("--baseline-ref")
      gate_args.push(value)
    }
    None => ()
  }
  if enforce { gate_args.push("--enforce") }
  run_step(root, output_dir, "checking coverage thresholds", "coverage-gate.log", gate_args)
  println("coverage gate passed")
  println(@fs.read_file(output_dir + "/coverage.md").text())
}
