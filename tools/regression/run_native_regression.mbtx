  budget_fields.remove("pdf_font_program_cache_bytes")
  budget_fields["budget_profile"] = Json("explicit_enforced")
  assert_eq(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
