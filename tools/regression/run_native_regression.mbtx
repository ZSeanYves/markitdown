  budget_fields["budget_profile"] = Json("measurement_only")
  let v7_coverage = string(budget_fields["budget_coverage"])
  let v7_unmeasured = string(budget_fields["budget_unmeasured"])
  budget_fields["budget_schema"] = Json("partial_v8")
  assert_true(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
