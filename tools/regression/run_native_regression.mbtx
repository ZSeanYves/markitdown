  budget_fields["budget_coverage"] = Json(v7_coverage)
  assert_true(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ) !=
    "",
  )
  budget_fields["budget_coverage"] = Json(
    "source_read_traffic,zip_inflate,pdf_flate_inflate,zip_payload_resident,pdf_flate_payload_and_modeled_scratch,ooxml_content_types_xml_work,ooxml_content_types_map_metadata,ooxml_content_types_resident,ooxml_relationships_xml_work,ooxml_relationships_row_and_index_string_metadata,ooxml_relationships_resident,yaml_reference_logical_work,pdf_structural_probe_work,pdf_structural_probe_payload_cache,ooxml_core_app_cursor_and_scalar_work,ooxml_core_app_selected_string_metadata,ooxml_core_app_buffer_and_retained_string_payload,pdf_indexed_stream_range_payload_and_scratch,pdf_indexed_dictionary_and_range_metadata,pdf_object_stream_member_work_and_cache,cli_source_asset_read_traffic,cli_source_asset_scope_cache,cli_source_asset_collection_working,ooxml_custom_cursor_and_serialized_value_work,ooxml_custom_name_type_value_metadata,ooxml_custom_namespace_and_value_buffer_payload,ooxml_custom_retained_string_payload,pdf_ranged_font_program_retained_payload,docx_paragraph_cursor_work,docx_paragraph_selected_string_metadata,docx_paragraph_cursor_and_raw_range_payload,docx_paragraph_retained_string_payload,pdf_pending_image_descriptor_and_reference_buffer_payload,pdf_pending_image_scope_name_utf16_payload,output_utf8_admission",
  )
  budget_fields["budget_unmeasured"] = Json("")
  assert_true(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ) !=
    "",
  )
  budget_fields["budget_schema"] = Json("partial_v999")
  assert_true(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ) !=
    "",
  )
  assert_true(!valid_budget_counter(Json("9223372036854775808")))
  assert_true(!valid_budget_counter(Json("-1")))
  assert_true(!valid_budget_counter(Json(0)))
  assert_true(valid_budget_counter(Json("9223372036854775807")))
  assert_true(!valid_rag_contract(@json.parse("{\"chunks\":\"wrong\"}")))
  assert_true(!valid_rag_contract(@json.parse("{\"unknown\":true}")))
  assert_true(clean("\"a\"\"b\"\"c\"") == "a\"b\"c")
  assert_true(markdown_literal("Text \\(page 1\\):") == "Text (page 1):")
  assert_true(
    asset_references("[remote](https://example.com/assets/a.png)").is_empty(),
  )
  assert_true(asset_references("![local](assets/a.png)") == ["assets/a.png"])
  assert_true(!signal_valid("unknown:foo", "markdown"))
  assert_true(!signal_valid("exact_count:x=1oops", "markdown"))
  assert_true(signal_valid("exact_count:cb=10=1", "markdown"))
  assert_true(split_count("cb=10=1") == ("cb=10", "1"))
  assert_true(
    decode_signals(
      "\"contains:console.log(\"\"hi\"\");image_ref\";asset_count_exact:1",
    ) ==
    Some("contains:console.log(\"hi\");image_ref;asset_count_exact:1"),
  )
  let fixture = @env.current_dir().unwrap_or(".") +
    "/.tmp/native-regression-selftest/" +
    @env.now().to_string()
  @fs.mkdir(fixture + "/external_main_process", recursive=true)
  let manifest = fixture + "/external_main_process/MANIFEST.tsv"
  let header = "id\tformat\tlane\tinput_path\texpected_path\tnotes\n"
  let missing_manifest = new_inventory()
  read_manifest(missing_manifest, fixture + "/missing", "main")
  assert_true(missing_manifest.errors.length() == 1)
  @fs.write_file(fixture + "/external_main_process/input.txt", "body\n")
  @fs.write_file(fixture + "/external_main_process/golden.md", "body\n")
  let valid_row = "valid\ttxt\tmarkdown\tinput.txt\tgolden.md\t\n"
  @fs.write_file(manifest, header + valid_row + valid_row)
  let duplicate = new_inventory()
  read_manifest(duplicate, fixture, "main")
  assert_true(duplicate.errors.any(error => error.contains("duplicate ID")))
  @fs.write_file(manifest, header + "broken\ttxt\tmarkdown\tinput.txt\n")
  let malformed = new_inventory()
  read_manifest(malformed, fixture, "main")
  assert_true(malformed.errors.any(error => error.contains("field count")))
  @fs.write_file(
    manifest,
    header + "missing\ttxt\tmarkdown\tmissing.txt\tgolden.md\t\n",
  )
  let missing_input = new_inventory()
  read_manifest(missing_input, fixture, "main")
  assert_true(
    missing_input.errors.any(error => {
      error.contains("missing main/missing/input")
    }),
  )
  @fs.write_file(manifest, header + valid_row)
  let valid = new_inventory()
  read_manifest(valid, fixture, "main")
  assert_true(
    valid.errors.is_empty() && valid.total == 1 && valid.cases.length() == 1,
  )
  assert_true(decode_signals("\"contains:unclosed") == None)
  assert_true(!safe_relative("../escape"))
  assert_true(!safe_id("../escape"))
  let channels : Map[String, String] = {
    "markdown": "body",
    "stdout": "decoy",
    "stderr": "InvalidInput",
  }
  assert_true(
    !signal_pass(
      "debug:not_contains:absent",
      "markdown",
      channels,
      "/missing",
      [],
      0,
    ),
  )
  assert_true(
    !signal_pass("contains:decoy", "markdown", channels, "/missing", [], 0),
  )
  assert_true(
    signal_pass(
      "stdout:contains:decoy",
      "markdown",
      channels,
      "/missing",
      [],
      0,
    ),
  )
  assert_true(
    signal_pass(
      "stderr:contains:InvalidInput",
      "markdown",
      channels,
      "/missing",
      [],
      4,
    ),
  )
  let expected = @json.parse(
    "{\"output_format\":\"rag_json\",\"chunk_count\":{\"exact\":1},\"chunks\":[{\"kind\":\"text\",\"text_contains_all\":[\"body\"],\"source_ref_count\":0,\"asset_ref_count\":0}]}",
  )
  let actual = @json.parse(
    "{\"output_format\":\"rag_json\",\"diagnostics\":{},\"assets\":[],\"chunks\":[{\"id\":\"c1\",\"kind\":\"text\",\"text\":\"body\",\"source_refs\":[],\"asset_refs\":[]}]}",
  )
  assert_true(rag_contract(expected, actual))
  assert_true(
    !rag_contract(
      expected,
      @json.parse(actual.stringify().replace(old="\"body\"", new="\"wrong\"")),
    ),
  )
  assert_true(
    !rag_contract(
      expected,
      @json.parse(
        actual
        .stringify()
        .replace(old="\"asset_refs\":[]", new="\"asset_refs\":[\"missing\"]"),
      ),
    ),
  )
  println("PASS harness self-test (tool evidence only)")
}

///|
async fn main {
  let args = @env.args()
  if (args.length() - 1) % 2 != 0 {
    fail(usage())
  }
  let options : Map[String, String] = Map([])
  for i = 1; i < args.length(); i = i + 2 {
    let key = args[i]
    if ![
        "--binary", "--lab", "--suite", "--format", "--case", "--evidence", "--validate-only",
        "--self-test", "--budget-profile",
      ].contains(key) ||
      options.contains(key) {
      fail(usage())
    }
    options[key] = args[i + 1]
  }
  if options.get("--self-test") == Some("true") {
    self_test()
    return
  }
  if options.get("--self-test").unwrap_or("false") != "false" {
    fail("invalid --self-test; expected true or false")
  }
  let root = @env.current_dir().unwrap_or(".")
  let evidence = options
    .get("--evidence")
    .unwrap_or(root + "/.tmp/native-regression/" + @env.now().to_string())
  if @fs.exists(evidence) {
    fail("evidence directory must be new: " + evidence)
  }
  @fs.mkdir(evidence, recursive=true)
  let inv = new_inventory()
  let suite = options.get("--suite").unwrap_or("all")
  let validate_only = options.get("--validate-only").unwrap_or("false")
  let budget_profile = options.get("--budget-profile").unwrap_or("false")
  let binary = options.get("--binary").unwrap_or("")
  let lab = options.get("--lab").unwrap_or(root + "/markitdown-quality-lab")
  let format = options.get("--format").unwrap_or("")
  let case_id = options.get("--case").unwrap_or("")
  let mut passed = 0
  let mut failed = 0
  let mut selected = 0
  let rows : Array[String] = ["suite\tid\tstatus\treason"]
  try {
    if !["main", "quality", "accurate", "all"].contains(suite) {
      fail("invalid suite")
    }
    if validate_only != "true" && validate_only != "false" {
      fail("invalid --validate-only")
    }
    if budget_profile != "true" && budget_profile != "false" {
      fail("invalid --budget-profile")
    }
    @fs.write_file(
      evidence + "/budget-profile-policy.txt",
      if budget_profile == "true" {
        "measurement_only; provenance sidecar requested for every successful conversion; failures retain errors, never zero usage; collecting CLI route; not a timing or complete budget acceptance window\n"
      } else {
        "disabled\n"
      },
    )
    if validate_only == "false" &&
      (!binary.has_prefix("/") || !@fs.exists(binary)) {
      fail("--binary must be an existing absolute Native executable path")
    }
    if binary != "" && !native_executable(binary) {
      fail(
        "binary must be an ELF/Mach-O Native executable; script/fake runners are tool evidence only",
      )
    }
    if binary != "" {
      record_path(inv, "native_executable", binary)
    }
    record_path(
      inv,
      "harness",
      root + "/tools/regression/run_native_regression.mbtx",
    )
    for kind in ["main", "quality", "accurate"] {
      if suite == "all" || suite == kind {
        read_manifest(inv, lab, kind)
      }
    }
    let git = @shell.Cmd("git", ["-C", lab, "rev-parse", "HEAD"], cwd=root).output()
    @fs.write_file(evidence + "/lab-head.txt", git.stdout())
    let dirty = @shell.Cmd("git", ["-C", lab, "status", "--short"], cwd=root).output()
    @fs.write_file(evidence + "/lab-status.txt", dirty.stdout())
    let version = @shell.Cmd("moon", ["version"], cwd=root).output()
    @fs.write_file(
      evidence + "/toolchain.txt",
      version.stdout() + version.stderr(),
    )
    let machine = @shell.Cmd("uname", ["-a"], cwd=root).output()
    @fs.write_file(
      evidence + "/machine.txt",
      machine.stdout() + machine.stderr(),
    )
    let source_head = @shell.Cmd(
      "git",
      ["-C", root, "rev-parse", "HEAD"],
      cwd=root,
    ).output()
    @fs.write_file(evidence + "/source-head.txt", source_head.stdout())
    for case in inv.cases {
      if (format == "" || case.format == format) &&
        (case_id == "" || case.id == case_id) {
        selected += 1
      }
    }
    if selected == 0 {
      inv.errors.push("zero selected tests")
    }
    if inv.errors.length() == 0 && validate_only == "false" {
      for case in inv.cases {
        if (format != "" && case.format != format) ||
          (case_id != "" && case.id != case_id) {
          continue
        }
        let reason = run_case(
          root,
          binary,
          case,
          evidence,
          budget_profile=budget_profile == "true",
        ) catch {
          error => "runner error: " + error.to_string()
        }
        let status = if reason == "" {
          passed += 1
          "pass"
        } else {
          failed += 1
          "fail"
        }
        rows.push(
          case.suite + "\t" + case.id + "\t" + status + "\t" + tsv(reason),
        )
        println(
          status +
          " " +
          case.suite +
          "/" +
          case.id +
          (if reason == "" { "" } else { ": " + reason }),
        )
      }
    }
  } catch {
    error => inv.errors.push(error.to_string())
  }
  let status = if inv.errors.length() > 0 || failed > 0 {
    "fail"
  } else if validate_only == "true" {
    "validated_only"
  } else {
    "pass"
  }
  @fs.write_file(evidence + "/cases.tsv", rows.join("\n") + "\n")
  @fs.write_file(evidence + "/errors.txt", inv.errors.join("\n") + "\n")
  @fs.write_file(
    evidence + "/normalizations.tsv",
    "row\trule\toriginal_width\tschema_width\n" +
    inv.normalizations.join("\n") +
    "\n",
  )
  @fs.write_file(
    evidence + "/fingerprints.tsv",
    "kind\tpath\tsha256\n" + inv.fingerprints.join("\n") + "\n",
  )
  @fs.write_file(
    evidence + "/summary.tsv",
    "status\ttarget\tsuite\ttotal\tretired\tvalid\tfiltered\tselected\texecuted\tpassed\tfailed\tmanifest_errors\tbinary\n" +
    status +
    "\tnative\t" +
    suite +
    "\t" +
    inv.total.to_string() +
    "\t" +
    inv.retired.to_string() +
    "\t" +
    inv.cases.length().to_string() +
    "\t" +
    (inv.cases.length() - selected).to_string() +
    "\t" +
    selected.to_string() +
    "\t" +
    (passed + failed).to_string() +
    "\t" +
    passed.to_string() +
    "\t" +
    failed.to_string() +
    "\t" +
    inv.errors.length().to_string() +
    "\t" +
    tsv(binary) +
    "\n",
  )
  println(
    "Native regression " +
    status +
    ": " +
    passed.to_string() +
    " passed, " +
    failed.to_string() +
    " failed; evidence: " +
    evidence,
  )
  if status == "fail" {
    fail("Native regression failed; see saved summary and errors")
  }
}
