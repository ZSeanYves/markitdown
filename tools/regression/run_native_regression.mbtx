        "budget_working_payload_peak_bytes": "zip_ooxml_content_types_relationships_core_app_custom_namespace_and_scalar_buffers_docx_paragraph_utf8_feed_token_fields_and_raw_inline_ranges_pdf_flate_indexed_stream_range_pending_image_descriptor_refbuffer_and_scope_name_utf16_cli_source_asset_collection_bounded_read_payload_modeled_scratch_upper_bound_and_xlsx_worksheet_cursor_utf8_feed_token_namespace_payload_upper_bound_and_pptx_presentation_cursor_utf8_feed_token_namespace_payload_upper_bound;plus_CLI_atomic_UTF8_encoder_N_validated_UTF8_payload_bytes_reserved_before_encode_per_call_and_released_after_call;excludes_stdio_allocator_path_nonAtomic_SDK_and_other_String_scratch;raw_selection_buffers_and_other_working_unmeasured_including_pptx_reference_tuple_array_map_and_probe_error_artifact_scratch;plus_EPUB_container_existing_XML_cursor_leases_normalize_path_14_times_fullpath_UTF16_code_units_plus2_private_payload_and_error_only_replay_8_times_combined_UTF8_bytes_plus12_scratch_and_separate_actual_carry_at_most3_bytes;not_tuple_row_Map_header_allocator_GC_RSS",
        "budget_temporary_payload_peak_bytes": "shared_ledger_lifetime_aggregate_reserved_file_payload_upper_bound_including_before_tighten_history;JSONL_TempOwner_frame_headers_and_UTF8_payload_plus_CLI_atomic_output_full_admitted_growth_including_failed_write_growth_and_any_other_registered_same_ledger_owner;admission_preflight_can_raise_peak_without_disk_growth;not_filesystem_blocks_or_all_temporary_storage",
        "budget_temporary_current_bytes": "currently_outstanding_shared_ledger_TemporaryBytes_credits;includes_JSONL_TempOwners_atomic_output_and_callers_live_owners_or_uncertain_atomic_close_credit;not_only_this_converter_or_filesystem_blocks",
      },
