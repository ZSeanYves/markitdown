      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ) !=
    "",
  )
  budget_fields["budget_unmeasured"] = Json(v7_unmeasured)
  budget_fields["pdf_pending_image_queue_capacity"] = Json("1")
  assert_true(
    budget_profile_error(
