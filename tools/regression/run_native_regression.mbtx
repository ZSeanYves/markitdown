        "scope_retained_payload_upper_bound" {
        return "unknown partial_v11 budget accounting policy"
      }
    }
    _ => return "unknown budget schema"
  }
  if fields.length() != expected_fields {
    return "unexpected budget field set"
  }
  for key in counters {
    if !valid_budget_counter(get_field(usage, key)) {
      return "missing or invalid budget counter: " + key
    }
  }
  if get_field(usage, "budget_output_admitted_utf8_bytes") !=
    get_field(usage, "budget_output_confirmed_utf8_bytes") {
    return "successful conversion has unconfirmed admitted output"
  }
  ""
}

