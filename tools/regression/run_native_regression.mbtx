        "epub_container_rootfile_selected_string_payload",
      ],
      "acceptance_state": "policy_frozen_for_integrated_validation;fresh_v13_runtime_tools_source_binary_quality_install_profiles_required;no_prior_sample_relabeling",
      "v12_existing_new_scopes": [
        "pdf_loaded_objstm_decoded_text_parse_work", "pdf_loaded_objstm_decoded_text_logical_retention",
        "pptx_presentation_cursor_work", "pptx_presentation_cursor_workspace", "pptx_presentation_reference_string_metadata",
        "pptx_presentation_reference_retained_string_payload",
      ],
      "generic_invariants": [
        "all_present_counters_and_optional_effective_cap_nonnegative_Int64_canonical_base10_strings",
        "temporary_current_le_temporary_peak", "output_confirmed_le_output_admitted",
        "field_names_and_count_exact_for_profile", "None_has_no_temporary_limit_field_not_zero_or_null;finite_has_exact_effective_cap_string",
      ],
      "not_generic_invariants": [
        "temporary_peak_le_current_effective_cap", "temporary_current_equals_zero",
        "output_confirmed_equals_output_admitted", "temporary_peak_equals_physical_disk_bytes",
      ],
      "fresh_cli_file_success_controls_only": [
        "origin_proven_fresh_CLI_with_no_prior_output_or_TemporaryBytes_usage", "all_relevant_file_output_is_within_declared_File_Atomic_LF_scope",
        "successful_owned_cleanup_or_commit_confirms_temporary_current_zero", "output_confirmed_equals_output_admitted_for_file_success_not_stdout_or_borrowed_ledger",
        "finite_limit_installed_before_first_growth_can_additionally_check_peak_le_cap",
      ],
    }
  }
}

///|
fn v13_keys(profile : String) -> Array[String] raise {
  guard v13_get(v13_contract(v13_finite(profile)), "counter_fields")
    is Array(keys) else {
    fail("v13 counter keys required")
  }
  keys.map(v13_text)
}

///|
fn v13_scope(profile : String, dimension : String) -> String raise {
  v13_text(
    v13_get(
      v13_get(v13_contract(v13_finite(profile)), "measurement_scopes"),
      dimension,
    ),
  )
}

///|
fn v13_unit(dimension : String) -> String {
  if dimension == "budget_parse_work" {
    "modeled_parse_work_units"
  } else {
    "bytes"
  }
}

///|
fn v13_validate(value : Json) -> Unit raise {
  guard value is Object(fields) else { fail("v13 usage object required") }
  assert_eq(v13_get(value, "budget_schema"), Json("partial_v13"))
  let profile = v13_text(v13_get(value, "budget_profile"))
  let finite = v13_finite(profile)
  let policy = v13_contract(finite)
  assert_eq(fields.length(), if finite { 16 } else { 15 })
  for
    (field, policy_key) in [
      ("budget_coverage", "coverage"),
      ("budget_unmeasured", "unmeasured"),
      ("budget_resident_policy", "resident_policy"),
    ] {
    assert_eq(v13_get(value, field), v13_get(policy, policy_key))
  }
  for key in v13_keys(profile) {
    ignore(v13_nat(v13_get(value, key)))
  }
  assert_true(
    v13_nat(v13_get(value, "budget_output_confirmed_utf8_bytes")) <=
    v13_nat(v13_get(value, "budget_output_admitted_utf8_bytes")),
  )
  assert_true(
    v13_nat(v13_get(value, "budget_temporary_current_bytes")) <=
    v13_nat(v13_get(value, "budget_temporary_payload_peak_bytes")),
  )
  if finite {
    ignore(v13_nat(v13_get(value, "budget_temporary_limit_bytes")))
  }
}

///|
fn v13_fixture(profile : String, cap : String) -> Json raise {
  let policy = v13_contract(v13_finite(profile))
  let fields : Map[String, Json] = {
    "budget_schema": Json("partial_v13"),
    "budget_profile": Json(profile),
    "budget_coverage": v13_get(policy, "coverage"),
    "budget_unmeasured": v13_get(policy, "unmeasured"),
    "budget_resident_policy": v13_get(policy, "resident_policy"),
  }
  for key in v13_keys(profile) {
    fields[key] = Json("0")
  }
  if v13_finite(profile) {
    fields["budget_temporary_limit_bytes"] = Json(cap)
  }
  Json::object(fields)
}

///|
fn v13_policy_self_test() -> Unit raise {
  let none = v13_fixture("measurement_only", "unused")
  v13_validate(none)
  let finite = v13_fixture("measurement_with_temporary_limit", "100")
  v13_validate(finite)
  assert_eq(
    v13_text(v13_get(v13_contract(false), "coverage"))
    .split(",")
    .to_array()
    .length(),
    56,
  )
  assert_eq(
    v13_text(v13_get(v13_contract(true), "coverage"))
    .split(",")
    .to_array()
    .length(),
    61,
  )
  assert_eq(
    v13_get(v13_contract(false), "resident_policy"),
    Json("scope_retained_payload_plus_owned_temporary_leases"),
  )
  assert_eq(
    v13_get(v13_contract(true), "resident_policy"),
    Json("scope_retained_payload_plus_owned_temporary_leases"),
  )
  let historical = match finite {
    Object(fields) => fields.copy()
    _ => fail("object")
  }
  historical["budget_temporary_payload_peak_bytes"] = Json("200")
  historical["budget_temporary_current_bytes"] = Json("1")
  v13_validate(Json::object(historical))
  let borrowed = match none {
    Object(fields) => fields.copy()
    _ => fail("object")
  }
  borrowed["budget_output_admitted_utf8_bytes"] = Json("9")
  borrowed["budget_output_confirmed_utf8_bytes"] = Json("3")
  borrowed["budget_temporary_payload_peak_bytes"] = Json("200")
  borrowed["budget_temporary_current_bytes"] = Json("1")
  v13_validate(Json::object(borrowed))
  let impossible_output = borrowed.copy()
  impossible_output["budget_output_confirmed_utf8_bytes"] = Json("10")
  assert_true(
    try {
      v13_validate(Json::object(impossible_output))
      false
    } catch {
      _ => true
    },
  )
  let impossible_resident = borrowed.copy()
  impossible_resident["budget_temporary_current_bytes"] = Json("201")
  assert_true(
    try {
      v13_validate(Json::object(impossible_resident))
      false
    } catch {
      _ => true
    },
  )
  let no_none_cap = borrowed.copy()
  no_none_cap["budget_temporary_limit_bytes"] = Json("200")
  assert_true(
    try {
      v13_validate(Json::object(no_none_cap))
      false
    } catch {
      _ => true
    },
  )
  for
    profile in [
      "measurement_only", "measurement_with_temporary_limit", "explicit_enforced",
    ] {
    let original = v13_fixture(profile, "0")
    v13_validate(original)
    let keys = v13_keys(profile)
    assert_eq(keys.length(), 10)
    for key in keys {
      assert_true(v13_scope(profile, key) != "")
      assert_eq(
        v13_unit(key),
        if key == "budget_parse_work" {
          "modeled_parse_work_units"
        } else {
          "bytes"
        },
      )
      for
        bad in [
          Json(0),
          Json(-1),
          Json(1.5),
          Json(true),
          Json::null(),
          Json("-1"),
          Json("01"),
          Json("9223372036854775808"),
        ] {
        let changed = match original {
          Object(fields) => fields.copy()
          _ => fail("object")
        }
        changed[key] = bad
        assert_true(
          try {
            v13_validate(Json::object(changed))
            false
          } catch {
            _ => true
          },
        )
      }
    }
    for
      (key, bad) in [
        ("budget_schema", Json("partial_v11")),
        ("budget_coverage", Json("old")),
        ("budget_unmeasured", Json("none")),
        ("budget_resident_policy", Json("rss")),
        ("budget_profile", Json("unrecognized")),
      ] {
      let changed = match original {
        Object(fields) => fields.copy()
        _ => fail("object")
      }
      changed[key] = bad
      assert_true(
        try {
          v13_validate(Json::object(changed))
          false
        } catch {
          _ => true
        },
      )
    }
    let extra = match original {
      Object(fields) => fields.copy()
      _ => fail("object")
    }
    extra["unrecognized"] = Json("0")
    assert_true(
      try {
        v13_validate(Json::object(extra))
        false
      } catch {
        _ => true
      },
    )
  }
  for
    missing in [
      "pdf_loaded_objstm_decoded_text_parse_work", "pdf_loaded_objstm_decoded_text_logical_retention",
      "pptx_presentation_cursor_work", "pptx_presentation_cursor_workspace", "pptx_presentation_reference_string_metadata",
      "pptx_presentation_reference_retained_string_payload",
    ] {
    let changed = match none {
      Object(fields) => fields.copy()
      _ => fail("object")
    }
    changed["budget_coverage"] = Json(
      v13_text(changed["budget_coverage"]).replace_all(
        old=missing + ",",
        new="",
      ),
    )
    assert_true(
      try {
        v13_validate(Json::object(changed))
        false
      } catch {
        _ => true
      },
    )
  }
  for
    missing in [
      "jsonl_spool_codec_wire_work", "jsonl_spool_read_traffic", "jsonl_spool_temporary_payload",
      "jsonl_spool_codec_working", "jsonl_spool_event_utf16_payload",
    ] {
    let changed = match finite {
      Object(fields) => fields.copy()
      _ => fail("object")
    }
    let coverage = v13_text(changed["budget_coverage"])
    changed["budget_coverage"] = Json(
      if coverage.has_suffix(missing) {
        coverage.strip_suffix("," + missing).unwrap().to_owned()
      } else {
        coverage.replace_all(old=missing + ",", new="")
      },
    )
    assert_true(
      try {
        v13_validate(Json::object(changed))
        false
      } catch {
        _ => true
      },
    )
  }
  guard v13_get(v13_contract(false), "new_scopes") is Array(scopes) else {
    fail("v13 exact new scopes required")
  }
  assert_eq(scopes.length(), 10)
  for label in scopes {
    let name = v13_text(label)
    for original in [none, finite] {
      let changed = match original {
        Object(fields) => fields.copy()
        _ => fail("object")
      }
      let coverage = v13_text(changed["budget_coverage"])
      assert_true(coverage.split(",").to_array().contains(name[:]))
      changed["budget_coverage"] = Json(
        coverage
        .split(",")
        .filter(token => token != name[:])
        .map(token => token.to_owned())
        .to_array()
        .join(","),
      )
      assert_true(
        try {
          v13_validate(Json::object(changed))
          false
        } catch {
          _ => true
        },
      )
    }
  }
  let wrong_current = historical.copy()
  wrong_current["budget_temporary_current_bytes"] = Json("201")
  assert_true(
    try {
      v13_validate(Json::object(wrong_current))
      false
    } catch {
      _ => true
    },
  )
}

///|
fn v13_runner_self_test() -> Unit raise {
  let fields = match v13_fixture("measurement_only", "unused") {
    Object(fields) => fields.copy()
    _ => fail("object")
  }
  fields["budget_output_admitted_utf8_bytes"] = Json("9")
  fields["budget_output_confirmed_utf8_bytes"] = Json("3")
  let wrapped = ({ "budget_usage": Json::object(fields) } : Json).stringify()
  assert_eq(budget_profile_error(wrapped), "")
  assert_true(budget_profile_error(wrapped, fresh_file_success=true) != "")
}

///|
async fn self_test() -> Unit {
  v13_policy_self_test()
  v13_runner_self_test()
  v12_policy_self_test()
  self_test_v11_budget_policy()
  self_test_v10_budget_policy()
  self_test_v9_budget_policy()
  assert_true(budget_profile_error("{}") != "")
  let budget_fields : Map[String, Json] = {
    "budget_profile": Json("measurement_only"),
    "budget_coverage": Json(
      "source_read_traffic,zip_entry_payloads,output_utf8_admission",
    ),
    "budget_unmeasured": Json(
      "parse_work,source_metadata,rag_metadata,ir,temporary_storage,non_zip_inflate,non_zip_working_and_cache",
    ),
    "budget_resident_policy": Json("scope_retained_payload_upper_bound"),
  }
  for
    key in [
      "budget_read_traffic_bytes", "budget_inflate_bytes", "budget_output_admitted_utf8_bytes",
      "budget_output_confirmed_utf8_bytes", "budget_zip_cache_payload_peak_bytes",
      "budget_zip_working_payload_peak_bytes",
    ] {
    budget_fields[key] = Json("0")
  }
  assert_eq(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ),
    "",
  )
  budget_fields.remove("budget_zip_cache_payload_peak_bytes")
  budget_fields.remove("budget_zip_working_payload_peak_bytes")
  budget_fields["budget_schema"] = Json("partial_v2")
  budget_fields["budget_coverage"] = Json(
    "source_read_traffic,zip_inflate,zip_payload_resident,ooxml_content_types_xml_work,ooxml_content_types_map_metadata,ooxml_content_types_resident,output_utf8_admission",
  )
  budget_fields["budget_unmeasured"] = Json(
    "non_content_types_parse_work,non_content_types_source_metadata,rag_metadata,ir,temporary_storage,non_zip_inflate,other_working_and_cache",
  )
  for
    key in [
      "budget_cache_payload_peak_bytes", "budget_working_payload_peak_bytes", "budget_parse_work",
      "budget_source_metadata_bytes",
    ] {
    budget_fields[key] = Json("0")
  }
  assert_eq(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ),
    "",
  )
  budget_fields["budget_schema"] = Json("partial_v3")
  budget_fields["budget_coverage"] = Json(
    "source_read_traffic,zip_inflate,pdf_flate_inflate,zip_payload_resident,pdf_flate_payload_and_modeled_scratch,ooxml_content_types_xml_work,ooxml_content_types_map_metadata,ooxml_content_types_resident,output_utf8_admission",
  )
  budget_fields["budget_unmeasured"] = Json(
    "non_content_types_parse_work,non_content_types_source_metadata,rag_metadata,ir,temporary_storage,other_inflate,pdf_non_flate_filters_predictors_and_text,other_working_and_cache",
  )
  assert_eq(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ),
    "",
  )
  budget_fields["budget_parse_work"] = Json(0)
  assert_true(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ) !=
    "",
  )
  budget_fields["budget_parse_work"] = Json("0")
  budget_fields["budget_schema"] = Json("partial_v4")
  // A new schema with the old coverage must fail before accepting its counters.
  assert_true(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ) !=
    "",
  )
  budget_fields["budget_coverage"] = Json(
    "source_read_traffic,zip_inflate,pdf_flate_inflate,zip_payload_resident,pdf_flate_payload_and_modeled_scratch,ooxml_content_types_xml_work,ooxml_content_types_map_metadata,ooxml_content_types_resident,ooxml_relationships_xml_work,ooxml_relationships_row_and_index_string_metadata,ooxml_relationships_resident,yaml_reference_logical_work,pdf_structural_probe_work,pdf_structural_probe_payload_cache,output_utf8_admission",
  )
  budget_fields["budget_unmeasured"] = Json(
    "other_parse_work,other_source_metadata,rag_metadata,ir,temporary_storage,other_inflate,pdf_non_flate_filters_predictors_and_text,pdf_full_xref_parser_and_scratch,yaml_lexing_events_and_weight_storage,ooxml_validation_issues_and_temporary_metadata,other_working_and_cache",
  )
  assert_eq(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ),
    "",
  )
  budget_fields["budget_parse_work"] = Json(0)
  assert_true(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ) !=
    "",
  )
  budget_fields["budget_parse_work"] = Json("0")
  budget_fields["budget_schema"] = Json("partial_v5")
  assert_true(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ) !=
    "",
  )
  budget_fields["budget_coverage"] = Json(
    "source_read_traffic,zip_inflate,pdf_flate_inflate,zip_payload_resident,pdf_flate_payload_and_modeled_scratch,ooxml_content_types_xml_work,ooxml_content_types_map_metadata,ooxml_content_types_resident,ooxml_relationships_xml_work,ooxml_relationships_row_and_index_string_metadata,ooxml_relationships_resident,yaml_reference_logical_work,pdf_structural_probe_work,pdf_structural_probe_payload_cache,ooxml_core_app_cursor_and_scalar_work,ooxml_core_app_selected_string_metadata,ooxml_core_app_buffer_and_retained_string_payload,pdf_indexed_stream_range_payload_and_scratch,pdf_indexed_dictionary_and_range_metadata,pdf_object_stream_member_work_and_cache,output_utf8_admission",
  )
  assert_eq(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ),
    "",
  )
  let v5_coverage = string(budget_fields["budget_coverage"])
  budget_fields["budget_schema"] = Json("partial_v6")
  assert_true(
    budget_profile_error(
      Json::object({ "budget_usage": Json::object(budget_fields) }).stringify(),
    ) !=
    "",
  )
  budget_fields["budget_coverage"] = Json(
    v5_coverage.replace_all(
      old="output_utf8_admission",
      new="cli_source_asset_read_traffic,cli_source_asset_scope_cache,cli_source_asset_collection_working,output_utf8_admission",
