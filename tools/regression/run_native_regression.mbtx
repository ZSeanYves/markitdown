///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/crypto",
}

///|
struct Case {
  id : String
  suite : String
  format : String
  lane : String
  input : String
  expected : String
  signals : String
  view : String
}

///|
struct Inventory {
  cases : Array[Case]
  errors : Array[String]
  mut total : Int32
  mut retired : Int32
  fingerprints : Array[String]
  normalizations : Array[String]
}

///|
fn new_inventory() -> Inventory {
  {
    cases: [],
    errors: [],
    total: 0,
    retired: 0,
    fingerprints: [],
    normalizations: [],
  }
}

///|
fn usage() -> String {
  "usage: run_native_regression.mbtx --binary ABSOLUTE_NATIVE_EXECUTABLE [--lab PATH] [--suite main|quality|accurate|all] [--format FORMAT] [--case ID] [--evidence NEW_DIRECTORY] [--validate-only true|false] [--budget-profile true|false] [--self-test true|false]"
}

///|
fn clean(value : String) -> String {
  let value = value.trim().to_owned()
  if value.length() >= 2 && value.has_prefix("\"") && value.has_suffix("\"") {
    value[1:value.length() - 1].to_owned().replace_all(old="\"\"", new="\"")
  } else {
    value
  }
}

///|
fn fields(line : String) -> Array[String] {
  line.split("\t").map(value => clean(value.to_owned())).to_array()
}

///|
fn decode_signals(value : String) -> String? {
  if !value.has_prefix("\"") {
    return Some(value)
  }
  let parts : Array[String] = []
  let mut start = 1
  let mut index = 1
  while index < value.length() {
    if value[index] == '"' {
      parts.push(value[start:index].to_owned())
      if index + 1 < value.length() && value[index + 1] == '"' {
        parts.push("\"")
        index += 2
        start = index
      } else {
        let suffix = value[index + 1:].to_owned()
        if suffix != "" && !suffix.has_prefix(";") {
          return None
        }
        return Some(parts.join("") + suffix)
      }
    } else {
      index += 1
    }
  }
  None
}

///|
fn split_first(value : String, delimiter : String) -> (String, String) {
  match value.find(delimiter) {
    Some(index) =>
      (value[:index].to_owned(), value[index + delimiter.length():].to_owned())
    None => (value, "")
  }
}

///|
fn split_count(value : String) -> (String, String) {
  let mut index = value.length() - 1
  while index >= 0 {
    if value[index] == '=' {
      return (value[:index].to_owned(), value[index + 1:].to_owned())
    }
    index -= 1
  }
  (value, "")
}

///|
fn tsv(value : String) -> String {
  value
  .replace(old="\t", new=" ")
  .replace(old="\r", new=" ")
  .replace(old="\n", new=" ")
}

///|
fn safe_id(value : String) -> Bool {
  if value == "" {
    return false
  }
  for ch in value {
    if !(ch >= 'a' && ch <= 'z') &&
      !(ch >= 'A' && ch <= 'Z') &&
      !(ch >= '0' && ch <= '9') &&
      ch != '_' &&
      ch != '-' &&
      ch != '.' {
      return false
    }
  }
  value != "." && value != ".."
}

///|
fn safe_relative(value : String) -> Bool {
  if value == "" || value.has_prefix("/") || value.contains("\\") {
    return false
  }
  for part in value.split("/") {
    if part == "" || part == "." || part == ".." {
      return false
    }
  }
  true
}

///|
fn number(value : String) -> Int32? {
  if value == "" {
    return None
  }
  let mut result = 0
  for ch in value {
    if ch < '0' || ch > '9' || result > 100000000 {
      return None
    }
    result = result * 10 + ch.to_int() - '0'.to_int()
  }
  Some(result)
}

///|
fn signal_parts(
  raw : String,
  default_view : String,
) -> (String, String, String) {
  let (prefix, tail) = split_first(raw, ":")
  if ["markdown", "debug", "provenance", "stdout", "stderr"].contains(prefix) {
    let (name, argument) = split_first(tail, ":")
    (prefix, name, argument)
  } else {
    (default_view, prefix, tail)
  }
}

///|
fn signal_valid(raw : String, view : String) -> Bool {
  let (_, name, argument) = signal_parts(raw, view)
  match name {
    "no_empty_output"
    | "heading_marker"
    | "table_marker"
    | "image_ref"
    | "link_ref" => argument == ""
    "contains" | "contains_all" | "not_contains" | "order" => argument != ""
    "asset_count_min"
    | "asset_count_exact"
    | "max_long_token_len"
    | "exit_code" => number(argument) is Some(_)
    "exact_count" | "min_count" | "max_count" => {
      let (key, value) = split_count(argument)
      key != "" && number(value) is Some(_)
    }
    "asset_exists" => safe_relative(argument)
    "asset_magic" | "asset_sha256" => {
      let (key, value) = split_first(argument, "=")
      safe_relative(key) && value != ""
    }
    _ => false
  }
}

///|
async fn hash(path : String) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(@fs.read_file(path).binary()))
}

///|
async fn native_executable(path : String) -> Bool {
  let bytes = @fs.read_file(path).binary()
  if bytes.length() < 4 {
    return false
  }
  let magic = bytes[:4].to_owned()
  [
    b"\x7fELF", b"\xcf\xfa\xed\xfe", b"\xfe\xed\xfa\xcf", b"\xce\xfa\xed\xfe", b"\xfe\xed\xfa\xce",
    b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca",
  ].contains(magic)
}

///|
async fn file_inventory(
  path : String,
  relative~ : String = "",
) -> Array[String] {
  let out : Array[String] = []
  for name in @fs.readdir(path) {
    let full = path + "/" + name
    let rel = if relative == "" { name } else { relative + "/" + name }
    let nested = Some(@fs.readdir(full)) catch { _ => None }
    match nested {
      Some(_) => out.append(file_inventory(full, relative=rel))
      None => out.push(rel + "\t" + hash(full))
    }
  }
  out.sort()
  out
}

///|
async fn record_path(inv : Inventory, label : String, path : String) -> Unit {
  if !@fs.exists(path) {
    inv.errors.push("missing " + label + ": " + path)
    return
  }
  let result = Some(hash(path)) catch { _ => None }
  match result {
    Some(value) => inv.fingerprints.push(label + "\t" + path + "\t" + value)
    None =>
      for item in file_inventory(path) {
        inv.fingerprints.push(label + "\t" + path + "/" + item)
      }
  }
}

///|
async fn read_manifest(inv : Inventory, lab : String, suite : String) -> Unit {
  let directory = if suite == "main" {
    "external_main_process"
  } else {
    "external_" + suite
  }
  let path = lab + "/" + directory + "/MANIFEST.tsv"
  if !@fs.exists(path) {
    inv.errors.push("missing manifest: " + path)
    return
  }
  record_path(inv, "manifest", path)
  let text = @fs.read_file(path).text()
  let lines = text.split("\n").to_array()
  let expected_header = if suite == "main" {
    "id\tformat\tlane\tinput_path\texpected_path\tnotes"
  } else {
    "id\tformat\tpath\tsource_type\tsource_id\tlicense_status\tlicense_review_status\tprivacy\tsize_class\tfeatures\texpected_signals\tquality_tier\toriginal_url\tlocal_cache_path\tnotes\tproposed_rel_path\tmigration_action\tmigration_note\tquality_tags\tquality_note\tproposed_expected_fail\tproposed_skip_reason" +
    (if suite == "accurate" { "\tvalidation_view" } else { "" })
  }
  if lines.length() == 0 || lines[0].trim() != expected_header {
    inv.errors.push("invalid manifest header: " + path)
    return
  }
  let seen : Map[String, Bool] = Map([])
  let width = if suite == "main" {
    6
  } else if suite == "accurate" {
    23
  } else {
    22
  }
  for i = 1; i < lines.length(); i = i + 1 {
    let raw = lines[i].to_owned()
    if i == lines.length() - 1 && raw == "" {
      continue
    }
    inv.total += 1
    let row = fields(raw)
    let context = suite + ":" + (i + 1).to_string()
    if row.length() != width {
      // Only optional empty tail cells are normalized, never required columns.
      let original_width = row.length()
      if suite == "main" || original_width < 20 {
        inv.errors.push(context + " invalid TSV field count")
        continue
      }
      let mut invalid_tail = false
      for extra = width; extra < row.length(); extra = extra + 1 {
        if row[extra] != "" {
          invalid_tail = true
        }
      }
      if invalid_tail {
        inv.errors.push(context + " unknown nonempty TSV column")
        continue
      }
      while row.length() < width {
        row.push("")
      }
      while row.length() > width {
        ignore(row.pop())
      }
      inv.normalizations.push(
        context +
        "\toptional_empty_tail\t" +
        original_width.to_string() +
        "\t" +
        width.to_string(),
      )
    }
    if !safe_id(row[0]) || row[1] == "" {
      inv.errors.push(context + " invalid ID/format")
      continue
    }
    if seen.contains(row[0]) {
      inv.errors.push(context + " duplicate ID: " + row[0])
      continue
    }
    seen[row[0]] = true
    if suite != "main" && row[16] == "retire" {
      if row[17] == "" {
        inv.errors.push(context + " retirement requires a reason")
      }
      inv.retired += 1
      continue
    }
    if suite != "main" && row[16] != "" && row[16] != "keep" {
      inv.errors.push(context + " unknown migration action: " + row[16])
      continue
    }
    if suite != "main" &&
      (row[6] != "approved" || row[21] != "" || row[20] != "") {
      inv.errors.push(
        context + " unapproved or ambiguous skip/expected-failure contract",
      )
      continue
    }
    let lane = if suite == "main" { row[2] } else { suite }
    if suite == "main" && !["markdown", "rag", "assets"].contains(lane) {
      inv.errors.push(context + " unknown lane: " + lane)
      continue
    }
    let view = if suite == "accurate" && row[22] != "" {
      row[22]
    } else if lane == "rag" {
      "rag"
    } else {
      "markdown"
    }
    if !["markdown", "rag", "debug", "provenance"].contains(view) {
      inv.errors.push(context + " unknown view: " + view)
      continue
    }
    let input = if suite == "main" { row[3] } else { row[2] }
    if !safe_relative(input) || (suite == "main" && !safe_relative(row[4])) {
      inv.errors.push(context + " unsafe input/golden path")
      continue
    }
    let raw_signals = if suite == "main" { "" } else { row[10] }
    guard decode_signals(raw_signals) is Some(signals) else {
      inv.errors.push(context + " invalid quoted signal group")
      continue
    }
    if signals != raw_signals {
      inv.normalizations.push(context + "\tquoted_signal_group\t\t")
    }
    if suite != "main" && signals == "" {
      inv.errors.push(context + " empty signals")
      continue
    }
    for signal in signals.split(";") {
      if signals != "" && !signal_valid(signal.to_owned(), view) {
        inv.errors.push(
          context + " unknown or malformed signal: " + signal.to_owned(),
        )
      }
    }
    let mut exit_contracts = 0
    let mut rejection = false
    let mut stderr_contract = false
    for signal in signals.split(";") {
      let (channel, name, argument) = signal_parts(signal.to_owned(), view)
      if name == "exit_code" {
        exit_contracts += 1
        rejection = number(argument).unwrap_or(0) != 0
      }
      if channel == "stderr" && (name == "contains" || name == "contains_all") {
        stderr_contract = true
      }
    }
    if exit_contracts > 1 || (rejection && !stderr_contract) {
      inv.errors.push(
        context +
        " rejection requires one exit_code and explicit stderr content",
      )
    }
    let base = lab + "/" + (if suite == "main" { directory + "/" } else { "" })
    let item : Case = {
      id: row[0],
      suite,
      format: row[1],
      lane,
      input: base + input,
      expected: if suite == "main" {
        base + row[4]
      } else {
        ""
      },
      signals,
      view,
    }
    record_path(inv, suite + "/" + item.id + "/input", item.input)
    if item.expected != "" {
      record_path(inv, suite + "/" + item.id + "/golden", item.expected)
    }
    if view == "rag" && item.expected != "" {
      try {
        let contract = @json.parse(
          @fs.read_file(item.expected).text(),
          reject_duplicate_keys=true,
        )
        if !valid_rag_contract(contract) {
          inv.errors.push(context + " invalid RAG contract schema")
        }
      } catch {
        error =>
          inv.errors.push(context + " invalid RAG golden: " + error.to_string())
      }
    }
    inv.cases.push(item)
  }
}

///|
fn get_field(value : Json, key : String) -> Json {
  if value is Object(values) {
    values.get(key).unwrap_or(Json::null())
  } else {
    Json::null()
  }
}

///|
fn valid_rag_contract(value : Json) -> Bool {
  guard value is Object(values) else { return false }
  if values.is_empty() {
    return false
  }
  for key, item in values {
    match key {
      "output_format"
      | "detected_format"
      | "parser_mode"
      | "convert_mode"
      | "output_mode" => if !(item is String(_)) { return false }
      "diagnostics_contains" | "metadata_contains" =>
        if !(item is Object(_)) {
          return false
        }
      "source_map" =>
        if string(item) != "null" && string(item) != "required" {
          return false
        }
      "chunk_count" => {
        guard item is Object(counts) else { return false }
        if counts.is_empty() {
          return false
        }
        for kind, amount in counts {
          if kind != "min" && kind != "exact" {
            return false
          }
          guard amount is Number(limit, ..) else { return false }
          if limit < 0.0 || limit != limit.to_int().to_double() {
            return false
          }
        }
      }
      "chunks" => {
        guard item is Array(chunks) else { return false }
        for chunk in chunks {
          guard chunk is Object(fields) else { return false }
          if fields.is_empty() {
            return false
          }
          for name, field in fields {
            match name {
              "kind" => if !(field is String(_)) { return false }
              "heading_path" | "text_contains_all" => {
                guard field is Array(items) else { return false }
                if !items.all(item => item is String(_)) {
                  return false
                }
              }
              "source_ref_count" | "asset_ref_count" => {
                guard field is Number(count, ..) else { return false }
                if count < 0.0 || count != count.to_int().to_double() {
                  return false
                }
              }
              "location_contains" => if !(field is Object(_)) { return false }
              _ => return false
            }
          }
        }
      }
      _ => return false
    }
  }
  true
}

///|
fn array(value : Json) -> Array[Json] {
  if value is Array(items) {
    items
  } else {
    []
  }
}

///|
fn string(value : Json) -> String {
  if value is String(text) {
    text
  } else {
    ""
  }
}

///|
fn subset(expected : Json, actual : Json) -> Bool {
  match expected {
    Object(values) => {
      guard actual is Object(items) else { return false }
      for key, value in values {
        match items.get(key) {
          Some(item) => if !subset(value, item) { return false }
          None => return false
        }
      }
      true
    }
    Array(values) => {
      guard actual is Array(items) else { return false }
      for value in values {
        if !items.any(item => subset(value, item)) {
          return false
        }
      }
      true
    }
    _ => expected == actual
  }
}

///|
fn chunk_matches(expected : Json, actual : Json) -> Bool {
  guard expected is Object(values) else { return false }
  for key, value in values {
    match key {
      "kind" | "heading_path" =>
        if value != get_field(actual, key) {
          return false
        }
      "source_ref_count" =>
        if value != Json(array(get_field(actual, "source_refs")).length()) {
          return false
        }
      "asset_ref_count" =>
        if value != Json(array(get_field(actual, "asset_refs")).length()) {
          return false
        }
      "text_contains_all" => {
        guard get_field(actual, "text") is String(text) else { return false }
        for item in array(value) {
          if !text.contains(string(item)) {
            return false
          }
        }
      }
      "location_contains" =>
        if !location_contains(
            value,
            get_field(get_field(actual, "metadata"), "location"),
          ) {
          return false
        }
      _ => return false
    }
  }
  true
}

///|
fn rag_contract(expected : Json, actual : Json) -> Bool {
  if !valid_rag_contract(expected) {
    return false
  }
  guard actual is Object(actual_fields) else { return false }
  guard get_field(actual, "chunks") is Array(chunks) else { return false }
  guard get_field(actual, "assets") is Array(assets) else { return false }
  guard get_field(actual, "diagnostics") is Object(_) else { return false }
  let chunk_ids : Map[String, Bool] = Map([])
  let asset_ids : Map[String, Bool] = Map([])
  for asset in assets {
    let id = string(get_field(asset, "asset_id"))
    if id == "" || asset_ids.contains(id) {
      return false
    }
    asset_ids[id] = true
  }
  for chunk in chunks {
    let id = string(get_field(chunk, "id"))
    if id == "" || chunk_ids.contains(id) {
      return false
    }
    chunk_ids[id] = true
    guard get_field(chunk, "text") is String(_) else { return false }
    guard get_field(chunk, "source_refs") is Array(refs) else { return false }
    guard get_field(chunk, "asset_refs") is Array(asset_refs) else {
      return false
    }
    for source in refs {
      if string(get_field(source, "file_id")) == "" {
        return false
      }
    }
    for asset in asset_refs {
      if !asset_ids.contains(string(asset)) {
        return false
      }
    }
  }
  guard expected is Object(values) else { return false }
  for key, value in values {
    match key {
      "output_format"
      | "detected_format"
      | "parser_mode"
      | "convert_mode"
      | "output_mode" => if value != get_field(actual, key) { return false }
      "diagnostics_contains" =>
        if !subset(value, get_field(actual, "diagnostics")) {
          return false
        }
      "metadata_contains" =>
        if !subset(value, get_field(actual, "metadata")) {
          return false
        }
      "source_map" => {
        if !actual_fields.contains("source_map") {
          return false
        }
        let actual_map = get_field(actual, key)
        if string(value) == "null" {
          if !(actual_map is Null) {
            return false
          }
        } else if string(value) == "required" {
          if actual_map is Null {
            return false
          }
        } else {
          return false
        }
      }
      "chunk_count" => {
        guard value is Object(counts) else { return false }
        for kind, count in counts {
          guard count is Number(limit, ..) else { return false }
          if kind == "min" {
            if chunks.length().to_double() < limit {
              return false
            }
          } else if kind == "exact" {
            if chunks.length().to_double() != limit {
              return false
            }
          } else {
            return false
          }
        }
      }
      "chunks" => {
        let mut index = 0
        for wanted in array(value) {
          let mut found = false
          while index < chunks.length() {
            let candidate = chunks[index]
            index += 1
            if chunk_matches(wanted, candidate) {
              found = true
              break
            }
          }
          if !found {
            return false
          }
        }
      }
      _ => return false
    }
  }
  true
}

///|
fn count(text : String, needle : String) -> Int32 {
  if needle == "" {
    return 0
  }
  let mut cursor = 0
  let mut count = 0
  while cursor < text.length() {
    match text[cursor:].find(needle) {
      None => break
      Some(index) => {
        count += 1
        cursor += index + needle.length()
      }
    }
  }
  count
}

///|
fn ordered(text : String, values : String) -> Bool {
  let mut cursor = 0
  for value in values.split("|") {
    if value == "" {
      continue
    }
    match text[cursor:].find(value) {
      None => return false
      Some(index) => cursor += index + value.length()
    }
  }
  true
}

///|
fn markdown_literal(value : String) -> String {
  let chars = value.iter().to_array()
  let out : Array[String] = []
  let mut index = 0
  while index < chars.length() {
    if chars[index] == '\\' &&
      index + 1 < chars.length() &&
      "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~".contains(
        chars[index + 1].to_string(),
      ) {
      index += 1
    }
    out.push(chars[index].to_string())
    index += 1
  }
  out.join("")
}

///|
fn location_contains(expected : Json, actual : Json) -> Bool {
  match expected {
    String(value) => actual is String(text) && text.contains(value)
    Object(values) => {
      guard actual is Object(items) else { return false }
      for key, value in values {
        guard items.get(key) is Some(item) else { return false }
        if !location_contains(value, item) {
          return false
        }
      }
      true
    }
    Array(values) => {
      guard actual is Array(items) else { return false }
      values.all(value => items.any(item => location_contains(value, item)))
    }
    _ => expected == actual
  }
}

///|
async fn signal_pass(
  raw : String,
  view : String,
  channels : Map[String, String],
  case_dir : String,
  assets : Array[String],
  exit : Int32,
) -> Bool {
  let (channel, name, argument) = signal_parts(raw, view)
  if !channels.contains(channel) &&
    !name.has_prefix("asset_") &&
    name != "exit_code" {
    return false
  }
  let raw_text = channels.get(channel).unwrap_or("")
  let text = if channel == "markdown" {
    markdown_literal(raw_text)
  } else {
    raw_text
  }
  let (key, expected) = if name == "exact_count" ||
    name == "min_count" ||
    name == "max_count" {
    split_count(argument)
  } else {
    split_first(argument, "=")
  }
  let key = if channel == "markdown" { markdown_literal(key) } else { key }
  let argument = if channel == "markdown" &&
    ["contains", "contains_all", "not_contains", "order"].contains(name) {
    markdown_literal(argument)
  } else {
    argument
  }
  let limit = number(if expected == "" { argument } else { expected }).unwrap_or(
    -1,
  )
  match name {
    "no_empty_output" => text.trim() != ""
    "contains" => text.contains(argument)
    "contains_all" =>
      argument.split("|").all(value => value == "" || text.contains(value))
    "not_contains" => !text.contains(argument)
    "exact_count" => count(text, key) == limit
    "min_count" => count(text, key) >= limit
    "max_count" => count(text, key) <= limit
    "order" => ordered(text, argument)
    "heading_marker" => text.contains("# ")
    "table_marker" => text.contains("| ") && text.contains("\n|")
    "image_ref" => text.contains("![")
    "link_ref" => text.contains("](")
    "asset_count_min" => assets.length() >= limit
    "asset_count_exact" => assets.length() == limit
    "asset_exists" => @fs.exists(case_dir + "/" + argument)
    "asset_sha256" =>
      @fs.exists(case_dir + "/" + key) && hash(case_dir + "/" + key) == expected
    "asset_magic" => {
      if !@fs.exists(case_dir + "/" + key) {
        return false
      }
      let bytes = @fs.read_file(case_dir + "/" + key).binary()
      let magic = if bytes.length() >= 4 &&
        bytes[0] == b'\x89' &&
        bytes[1] == b'P' &&
        bytes[2] == b'N' &&
        bytes[3] == b'G' {
        "png"
      } else if bytes.length() >= 3 &&
        bytes[0] == b'\xff' &&
        bytes[1] == b'\xd8' &&
        bytes[2] == b'\xff' {
        "jpeg"
      } else if bytes.length() >= 3 &&
        bytes[0] == b'G' &&
        bytes[1] == b'I' &&
        bytes[2] == b'F' {
        "gif"
      } else if bytes.length() >= 4 &&
        (
          (
            bytes[0] == b'I' &&
            bytes[1] == b'I' &&
            bytes[2] == b'\x2a' &&
            bytes[3] == b'\x00'
          ) ||
          (
            bytes[0] == b'M' &&
            bytes[1] == b'M' &&
            bytes[2] == b'\x00' &&
            bytes[3] == b'\x2a'
          )
        ) {
        "tiff"
      } else if bytes.length() >= 2 && bytes[0] == b'B' && bytes[1] == b'M' {
        "bmp"
      } else if bytes.length() >= 2 && bytes[0] == b'P' && bytes[1] == b'K' {
        "zip"
      } else if bytes.length() >= 12 &&
        bytes[0] == b'R' &&
        bytes[8] == b'W' &&
        bytes[9] == b'E' &&
        bytes[10] == b'B' &&
        bytes[11] == b'P' {
        "webp"
      } else {
        "unknown"
      }
      magic == expected
    }
    "max_long_token_len" =>
      text.split(" ").all(value => value.length() <= limit)
    "exit_code" => exit == limit
    _ => false
  }
}

///|
async fn read_optional(path : String) -> String {
  if @fs.exists(path) {
    @fs.read_file(path).text()
  } else {
    ""
  }
}

///|
fn asset_references(text : String) -> Array[String] {
  let out : Array[String] = []
  let mut cursor = 0
  while cursor < text.length() {
    match text[cursor:].find("](assets/") {
      None => break
      Some(index) => {
        let start = cursor + index + 2
        let mut end = start
        while end < text.length() {
          let ch = text[end]
          if ch == ')' ||
            ch == '"' ||
            ch == '\'' ||
            ch == ' ' ||
            ch == '\n' ||
            ch == '\r' ||
            ch == '<' ||
            ch == '>' {
            break
          }
          end += 1
        }
        if end > start {
          out.push(text[start:end].to_owned())
        }
        cursor = if end > start { end } else { start + 1 }
      }
    }
  }
  out
}

///|
async fn run_case(
  root : String,
  binary : String,
  case : Case,
  evidence : String,
  budget_profile~ : Bool = false,
) -> String {
  let case_dir = evidence + "/cases/" + case.suite + "/" + case.id
  @fs.mkdir(case_dir, recursive=true)
  let extension = if case.view == "rag" {
    "rag.json"
  } else if case.view == "debug" {
    "debug.json"
  } else {
    "md"
  }
  let output = case_dir + "/result." + extension
  let args : Array[String] = [
    if case.suite == "accurate" {
      "accurate"
    } else {
      "balance"
    },
  ]
  if case.view == "rag" {
    args.push("--rag")
  }
  if case.view == "debug" {
    args.push("--debug")
  }
  if case.suite != "main" {
    args.append(["--format", case.format])
  }
  if case.view == "provenance" || budget_profile {
    args.append(["--provenance-out", case_dir + "/provenance.json"])
  }
  args.append([case.input, output])
  let command : Json = { "program": Json(binary), "args": Json(args) }
  @fs.write_file(case_dir + "/command.json", command.stringify())
  let result = @shell.Cmd(binary, args, cwd=root).output()
  @fs.write_file(case_dir + "/stdout.log", result.stdout())
  @fs.write_file(case_dir + "/stderr.log", result.stderr())
  @fs.write_file(case_dir + "/exit_code.txt", result.exit_code().to_string())
  let text = read_optional(output)
  let channels : Map[String, String] = {
    "stdout": result.stdout(),
    "stderr": result.stderr(),
  }
  if @fs.exists(output) {
    channels[if case.view == "provenance" { "markdown" } else { case.view }] = text
  }
  if @fs.exists(case_dir + "/provenance.json") {
    channels["provenance"] = read_optional(case_dir + "/provenance.json")
  }
  let asset_dir = case_dir + "/assets"
  let assets = if @fs.exists(asset_dir) {
    file_inventory(asset_dir)
  } else {
    []
  }
  @fs.write_file(
    case_dir + "/assets.tsv",
    "path\tsha256\n" + assets.join("\n") + "\n",
  )
  let mut expected_exit = 0
  for raw in case.signals.split(";") {
    let (_, name, argument) = signal_parts(raw.to_owned(), case.view)
    if name == "exit_code" {
      expected_exit = number(argument).unwrap_or(-1)
    }
  }
  if result.exit_code() != expected_exit {
    return "exit code " +
      result.exit_code().to_string() +
      ", expected " +
      expected_exit.to_string()
  }
  if expected_exit == 0 && !@fs.exists(output) {
    return "missing output"
  }
  if budget_profile && expected_exit == 0 {
    // This runner's saved command is a fresh process writing the fresh case
    // directory's ordinary file, and this branch has observed successful exit.
    let problem = budget_profile_error(
      channels.get("provenance").unwrap_or(""),
      fresh_file_success=output != "-",
    )
    if problem != "" {
      return problem
    }
  }
  if budget_profile && expected_exit != 0 {
    @fs.write_file(
      case_dir + "/budget-status.txt",
      "unavailable_expected_rejection; not zero consumption\n",
    )
  }
  if case.expected != "" {
    let golden = if case.lane == "assets" {
      case.expected + "/result.md"
    } else {
      case.expected
    }
    let expected = @fs.read_file(golden).text()
    if case.view == "rag" {
      let actual_json = @json.parse(text, reject_duplicate_keys=true)
      let declarations : Map[String, Bool] = Map([])
      for asset in array(get_field(actual_json, "assets")) {
        declarations[string(get_field(asset, "asset_id"))] = true
      }
      for chunk in array(get_field(actual_json, "chunks")) {
        for asset in array(get_field(chunk, "asset_refs")) {
          if !declarations.contains(string(asset)) {
            return "RAG dangling asset reference: " + string(asset)
          }
        }
      }
      if !rag_contract(
          @json.parse(expected, reject_duplicate_keys=true),
          actual_json,
        ) {
        return "RAG structural contract mismatch"
      }
    } else if expected != text {
      return "Markdown golden mismatch"
    }
  }
  for asset in asset_references(text) {
    if !safe_relative(asset) || !@fs.exists(case_dir + "/" + asset) {
      return "unreachable asset reference: " + asset
    }
  }
  if case.lane == "assets" {
    let expected_assets = case.expected + "/assets"
    let expected_set = if @fs.exists(expected_assets) {
      file_inventory(expected_assets)
    } else {
      []
    }
    if expected_set != assets {
      return "asset set or SHA-256 mismatch"
    }
  }
  for raw in case.signals.split(";") {
    if raw != "" &&
      !signal_pass(
        raw.to_owned(),
        case.view,
        channels,
        case_dir,
        assets,
        result.exit_code(),
      ) {
      return "signal: " + raw.to_owned()
    }
  }
  ""
}

///|
fn valid_budget_counter(value : Json) -> Bool {
  guard value is String(text) && text != "" && text.length() <= 19 else {
    return false
  }
  if text.length() > 1 && text[0] == '0' {
    return false
  }
  let mut count = 0L
  for ch in text {
    let digit = ch.to_int() - 48
    if digit < 0 ||
      digit > 9 ||
      count > (9223372036854775807L - digit.to_int64()) / 10L {
      return false
    }
    count = count * 10L + digit.to_int64()
  }
  true
}

///|
fn budget_profile_error(
  provenance : String,
  fresh_file_success~ : Bool = false,
) -> String {
  let parsed = @json.parse(provenance, reject_duplicate_keys=true) catch {
    _ => return "missing or malformed budget provenance"
  }
  let usage = get_field(parsed, "budget_usage")
  guard usage is Object(fields) else { return "missing budget_usage object" }
  if get_field(usage, "budget_schema") == Json("partial_v13") {
    return try {
      v13_validate(usage)
      if fresh_file_success {
        assert_eq(
          v13_get(usage, "budget_output_admitted_utf8_bytes"),
          v13_get(usage, "budget_output_confirmed_utf8_bytes"),
        )
      }
      ""
    } catch {
      error => "invalid v13 budget profile: " + error.to_string()
    }
  }
  if get_field(usage, "budget_schema") == Json("partial_v12") {
    return try {
      v12_validate(usage)
      assert_eq(
        v12_get(usage, "budget_output_admitted_utf8_bytes"),
        v12_get(usage, "budget_output_confirmed_utf8_bytes"),
      )
      ""
    } catch {
      error => "invalid v12 budget profile: " + error.to_string()
    }
  }
  if !["measurement_only", "explicit_enforced"].contains(
      string(get_field(usage, "budget_profile")),
    ) {
    return "unknown budget profile"
  }
  for
    label in ["budget_coverage", "budget_unmeasured", "budget_resident_policy"] {
    if string(get_field(usage, label)) == "" {
      return "missing budget accounting policy: " + label
    }
  }
  let counters = [
    "budget_read_traffic_bytes", "budget_inflate_bytes", "budget_output_admitted_utf8_bytes",
    "budget_output_confirmed_utf8_bytes",
  ]
  let mut expected_fields = 10
  match fields.get("budget_schema") {
    None => {
      counters.append([
        "budget_zip_cache_payload_peak_bytes", "budget_zip_working_payload_peak_bytes",
      ])
      if string(get_field(usage, "budget_coverage")) !=
        "source_read_traffic,zip_entry_payloads,output_utf8_admission" ||
        string(get_field(usage, "budget_unmeasured")) !=
        "parse_work,source_metadata,rag_metadata,ir,temporary_storage,non_zip_inflate,non_zip_working_and_cache" ||
        string(get_field(usage, "budget_resident_policy")) !=
        "scope_retained_payload_upper_bound" {
        return "unknown legacy budget accounting policy"
      }
    }
    Some(String("partial_v2")) => {
      expected_fields = 13
      counters.append([
        "budget_cache_payload_peak_bytes", "budget_working_payload_peak_bytes", "budget_parse_work",
        "budget_source_metadata_bytes",
      ])
      if string(get_field(usage, "budget_coverage")) !=
        "source_read_traffic,zip_inflate,zip_payload_resident,ooxml_content_types_xml_work,ooxml_content_types_map_metadata,ooxml_content_types_resident,output_utf8_admission" ||
        string(get_field(usage, "budget_unmeasured")) !=
        "non_content_types_parse_work,non_content_types_source_metadata,rag_metadata,ir,temporary_storage,non_zip_inflate,other_working_and_cache" ||
        string(get_field(usage, "budget_resident_policy")) !=
        "scope_retained_payload_upper_bound" {
        return "unknown partial_v2 budget accounting policy"
      }
    }
    Some(String("partial_v3")) => {
      expected_fields = 13
      counters.append([
        "budget_cache_payload_peak_bytes", "budget_working_payload_peak_bytes", "budget_parse_work",
        "budget_source_metadata_bytes",
      ])
      if string(get_field(usage, "budget_coverage")) !=
        "source_read_traffic,zip_inflate,pdf_flate_inflate,zip_payload_resident,pdf_flate_payload_and_modeled_scratch,ooxml_content_types_xml_work,ooxml_content_types_map_metadata,ooxml_content_types_resident,output_utf8_admission" ||
        string(get_field(usage, "budget_unmeasured")) !=
        "non_content_types_parse_work,non_content_types_source_metadata,rag_metadata,ir,temporary_storage,other_inflate,pdf_non_flate_filters_predictors_and_text,other_working_and_cache" ||
        string(get_field(usage, "budget_resident_policy")) !=
