///|
fn v12_keys(profile : String) -> Array[String] raise {
  guard v12_get(v12_contract(v12_finite(profile)), "counter_fields")
    is Array(keys) else {
    fail("v12 counter keys required")
  }
  keys.map(v12_text)
}

///|
fn v12_scope(profile : String, dimension : String) -> String raise {
  v12_text(
    v12_get(
      v12_get(v12_contract(v12_finite(profile)), "measurement_scopes"),
      dimension,
    ),
  )
}

///|
fn v12_unit(dimension : String) -> String {
  if dimension == "budget_parse_work" {
    "modeled_parse_work_units"
  } else {
    "bytes"
  }
}

///|
fn v12_validate(value : Json) -> Unit raise {
  guard value is Object(fields) else { fail("v12 usage object required") }
  assert_eq(v12_get(value, "budget_schema"), Json("partial_v12"))
  let profile = v12_text(v12_get(value, "budget_profile"))
  let finite = v12_finite(profile)
  let policy = v12_contract(finite)
  assert_eq(fields.length(), if finite { 16 } else { 13 })
  for
    (field, policy_key) in [
      ("budget_coverage", "coverage"),
      ("budget_unmeasured", "unmeasured"),
      ("budget_resident_policy", "resident_policy"),
    ] {
    assert_eq(v12_get(value, field), v12_get(policy, policy_key))
  }
  for key in v12_keys(profile) {
    ignore(v12_nat(v12_get(value, key)))
  }
  assert_true(
    v12_nat(v12_get(value, "budget_output_confirmed_utf8_bytes")) <=
    v12_nat(v12_get(value, "budget_output_admitted_utf8_bytes")),
  )
  if finite {
    ignore(v12_nat(v12_get(value, "budget_temporary_limit_bytes")))
    assert_true(
      v12_nat(v12_get(value, "budget_temporary_current_bytes")) <=
      v12_nat(v12_get(value, "budget_temporary_payload_peak_bytes")),
    )
  }
}

///|
fn v12_fixture(profile : String, cap : String) -> Json raise {
  let policy = v12_contract(v12_finite(profile))
  let fields : Map[String, Json] = {
    "budget_schema": Json("partial_v12"),
    "budget_profile": Json(profile),
    "budget_coverage": v12_get(policy, "coverage"),
    "budget_unmeasured": v12_get(policy, "unmeasured"),
    "budget_resident_policy": v12_get(policy, "resident_policy"),
  }
  for key in v12_keys(profile) {
    fields[key] = Json("0")
  }
  if v12_finite(profile) {
    fields["budget_temporary_limit_bytes"] = Json(cap)
  }
  Json::object(fields)
}

///|
fn v12_policy_self_test() -> Unit raise {
  let none = v12_fixture("measurement_only", "unused")
  v12_validate(none)
  let finite = v12_fixture("measurement_with_temporary_limit", "100")
  v12_validate(finite)
  let historical = match finite {
    Object(fields) => fields.copy()
    _ => fail("object")
  }
  historical["budget_temporary_payload_peak_bytes"] = Json("200")
  historical["budget_temporary_current_bytes"] = Json("1")
  v12_validate(Json::object(historical))
  for
    profile in [
      "measurement_only", "measurement_with_temporary_limit", "explicit_enforced",
    ] {
    let original = v12_fixture(profile, "0")
    v12_validate(original)
    let keys = v12_keys(profile)
    assert_eq(keys.length(), if v12_finite(profile) { 10 } else { 8 })
    for key in keys {
      assert_true(v12_scope(profile, key) != "")
      assert_eq(
        v12_unit(key),
        if key == "budget_parse_work" {
          "modeled_parse_work_units"
        } else {
          "bytes"
        },
      )
      for
        bad in [
          Json(0),
          Json(-1),
          Json(1.5),
          Json(true),
          Json::null(),
          Json("-1"),
          Json("01"),
          Json("9223372036854775808"),
        ] {
        let changed = match original {
          Object(fields) => fields.copy()
          _ => fail("object")
        }
        changed[key] = bad
        assert_true(
          try {
            v12_validate(Json::object(changed))
            false
          } catch {
            _ => true
          },
        )
      }
    }
    for
      (key, bad) in [
        ("budget_schema", Json("partial_v11")),
        ("budget_coverage", Json("old")),
        ("budget_unmeasured", Json("none")),
        ("budget_resident_policy", Json("rss")),
        ("budget_profile", Json("unrecognized")),
      ] {
      let changed = match original {
        Object(fields) => fields.copy()
        _ => fail("object")
      }
      changed[key] = bad
      assert_true(
        try {
          v12_validate(Json::object(changed))
          false
        } catch {
          _ => true
        },
      )
    }
    let extra = match original {
      Object(fields) => fields.copy()
      _ => fail("object")
    }
    extra["unrecognized"] = Json("0")
    assert_true(
      try {
        v12_validate(Json::object(extra))
        false
      } catch {
        _ => true
      },
    )
  }
  for
    missing in [
      "pdf_loaded_objstm_decoded_text_parse_work", "pdf_loaded_objstm_decoded_text_logical_retention",
      "pptx_presentation_cursor_work", "pptx_presentation_cursor_workspace", "pptx_presentation_reference_string_metadata",
      "pptx_presentation_reference_retained_string_payload",
    ] {
    let changed = match none {
      Object(fields) => fields.copy()
      _ => fail("object")
    }
    changed["budget_coverage"] = Json(
      v12_text(changed["budget_coverage"]).replace_all(
        old=missing + ",",
        new="",
      ),
    )
    assert_true(
      try {
        v12_validate(Json::object(changed))
        false
      } catch {
        _ => true
      },
    )
  }
  for
    missing in [
      "jsonl_spool_codec_wire_work", "jsonl_spool_read_traffic", "jsonl_spool_temporary_payload",
      "jsonl_spool_codec_working", "jsonl_spool_event_utf16_payload",
    ] {
    let changed = match finite {
      Object(fields) => fields.copy()
      _ => fail("object")
    }
    let coverage = v12_text(changed["budget_coverage"])
    changed["budget_coverage"] = Json(
      if coverage.has_suffix(missing) {
        coverage.strip_suffix("," + missing).unwrap().to_owned()
      } else {
        coverage.replace_all(old=missing + ",", new="")
      },
    )
    assert_true(
      try {
        v12_validate(Json::object(changed))
        false
      } catch {
        _ => true
      },
    )
  }
  let wrong_current = historical.copy()
  wrong_current["budget_temporary_current_bytes"] = Json("201")
  assert_true(
    try {
      v12_validate(Json::object(wrong_current))
      false
    } catch {
      _ => true
    },
  )
}

///|
fn v13_get(value : Json, key : String) -> Json raise {
  guard value is Object(fields) else { fail("v13 object required") }
  fields.get(key).unwrap_or_else(() => fail("v13 missing field: " + key))
}

///|
fn v13_text(value : Json) -> String raise {
  guard value is String(text) else { fail("v13 JSON string required") }
  text
}

///|
fn v13_nat(value : Json) -> Int64 raise {
  let text = v13_text(value)
  guard text != "" && (text == "0" || text[0] != '0') else {
    fail("v13 canonical decimal required")
  }
  let mut result = 0L
  for ch in text {
    guard ch >= '0' && ch <= '9' else {
      fail("v13 nonnegative decimal required")
    }
    let digit = (ch.to_int() - 48).to_int64()
    guard result <= (9223372036854775807L - digit) / 10L else {
      fail("v13 Int64 overflow")
    }
    result = result * 10L + digit
  }
  result
}

///|
fn v13_finite(profile : String) -> Bool raise {
  match profile {
    "measurement_only" => false
    "measurement_with_temporary_limit" | "explicit_enforced" => true
    _ => fail("unrecognized v13 budget profile")
  }
}

