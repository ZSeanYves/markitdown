///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/crypto",
}

///|
struct Evidence {
  directory : String
  commands : Array[Json]
  phases : Array[String]
  errors : Array[String]
  fingerprints : Array[String]
  mut binary : String
  mut executable_bytes : Int64
  mut install_bytes : Int64
}

///|
fn usage() -> String {
  "usage: native_install.mbtx --source local|git|registry --root ABS_ROOT --evidence NEW_ABS_DIR [--git-url URL --rev FULL40SHA] [--coordinate owner/module@EXACTVERSION] [--prepare-only true|false] [--audit-bench true|false]"
}

///|
fn field(value : String) -> String {
  value
  .replace_all(old="\t", new=" ")
  .replace_all(old="\n", new=" ")
  .replace_all(old="\r", new=" ")
}

///|
fn full_revision(value : String) -> Bool {
  value.length() == 40 &&
  value.iter().all(ch => (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f'))
}

///|
fn exact_coordinate(value : String) -> (String, String)? {
  let parts = value.split("@").to_array()
  if parts.length() != 2 ||
    !parts[0].contains("/") ||
    parts[0].has_prefix("/") ||
    parts[0].has_suffix("/") ||
    parts[1] == "" ||
    parts[1] == "latest" ||
    parts[1].contains("*") ||
    parts[1].contains("^") ||
    parts[1].contains("~") ||
    !parts[1]
    .iter()
    .all(ch => {
      (ch >= '0' && ch <= '9') ||
      (ch >= 'A' && ch <= 'Z') ||
      (ch >= 'a' && ch <= 'z') ||
      ch == '.' ||
      ch == '-' ||
      ch == '+'
    }) {
    None
  } else {
    Some((parts[0].to_owned(), parts[1].to_owned()))
  }
}

///|
async fn capture(
  evidence : Evidence,
  label : String,
  program : String,
  args : Array[String],
  cwd : String,
  checked~ : Bool = true,
) -> String {
  evidence.commands.push({
    "label": Json(label),
    "program": Json(program),
    "args": Json(args),
    "cwd": Json(cwd),
  })
  let result = @shell.Cmd(program, args, cwd~).output()
  @fs.write_file(
    evidence.directory + "/logs/" + label + ".stdout",
    result.stdout(),
  )
  @fs.write_file(
    evidence.directory + "/logs/" + label + ".stderr",
    result.stderr(),
  )
  @fs.write_file(
    evidence.directory + "/logs/" + label + ".exit",
    result.exit_code().to_string(),
  )
  if checked && result.exit_code() != 0 {
    evidence.phases.push(label + "\tfail\t" + result.exit_code().to_string())
    fail(
      label +
      " failed with exit " +
      result.exit_code().to_string() +
      "; see logs",
    )
  }
  evidence.phases.push(
    label +
    "\t" +
    (if result.exit_code() == 0 { "pass" } else { "recorded_nonzero" }) +
    "\t" +
    result.exit_code().to_string(),
  )
  result.stdout()
}

///|
async fn fingerprint(
  evidence : Evidence,
  label : String,
  path : String,
) -> Int64 {
  let bytes = @fs.read_file(path).binary()
  let size = bytes.length().to_int64()
  let hash = @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
  evidence.fingerprints.push(
    label + "\t" + path + "\t" + size.to_string() + "\t" + hash,
  )
  size
}

///|
async fn inventory(evidence : Evidence, directory : String) -> Int64 {
  let mut total = 0L
  for name in @fs.readdir(directory) {
    let path = directory + "/" + name
    match @fs.kind(path) {
      @fs.Directory => total += inventory(evidence, path)
      @fs.Regular => total += fingerprint(evidence, "install_file", path)
      _ => fail("unexpected nonregular installed entry: " + path)
    }
  }
  total
}

///|
async fn module_identity(root : String) -> (String, String) {
  if @fs.exists(root + "/moon.mod") {
    let mut name = ""
    let mut version = ""
    for line in @fs.read_file(root + "/moon.mod").text().split("\n") {
      let parts = line.split("=").to_array()
      if parts.length() != 2 {
        continue
      }
      let key = parts[0].trim()
      let raw = parts[1].trim().to_owned()
      if raw.length() < 2 || !raw.has_prefix("\"") || !raw.has_suffix("\"") {
        continue
      }
      let value = raw[1:raw.length() - 1].to_owned()
      if key == "name" {
        name = value
      }
      if key == "version" {
        version = value
      }
    }
    if name == "" || version == "" {
      fail("cannot read module name/version from " + root + "/moon.mod")
    }
    (name, version)
  } else {
    let value = @json.parse(
      @fs.read_file(root + "/moon.mod.json").text(),
      reject_duplicate_keys=true,
    )
    guard value is Object(fields) else { fail("invalid moon.mod.json") }
    guard fields.get("name") is Some(String(name)) else {
      fail("missing module name")
    }
    guard fields.get("version") is Some(String(version)) else {
      fail("missing module version")
    }
    (name, version)
  }
}

