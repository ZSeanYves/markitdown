import {
  "ZSeanYves/markitdown/internal/readers/xml" @dxml,
  "ZSeanYves/markitdown/lib/core",
  "ZSeanYves/markitdown/lib/formats/shared" @fshared,
  "ZSeanYves/markitdown/lib/input",
  "ZSeanYves/markitdown/internal/parser",
}

import {
  "moonbitlang/async",
  "moonbitlang/core/encoding/utf8",
} for "wbtest"

supported_targets = "native"

options(
  "preferred-target": "native",
)
