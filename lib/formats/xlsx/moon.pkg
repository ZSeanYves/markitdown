import {
  "ZSeanYves/markitdown/internal/readers/xml",
  "ZSeanYves/markitdown/internal/resource_budget" @budget,
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
  "ZSeanYves/markitdown/internal/readers/ooxml/package" @ox,
  "ZSeanYves/markitdown/internal/readers/ooxml/xlsx" @drxlsx,
  "ZSeanYves/markitdown/internal/readers/ooxml/shared",
  "ZSeanYves/markitdown/internal/readers/source_io" @sourceio,
  "ZSeanYves/markitdown/internal/readers/zip" @dzip,
  "ZSeanYves/markitdown/lib/core",
  "ZSeanYves/markitdown/lib/formats/shared" @fshared,
  "ZSeanYves/markitdown/lib/input",
  "ZSeanYves/markitdown/internal/parser",
  "ZSeanYves/markitdown/lib/product",
