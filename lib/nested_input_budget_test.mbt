///|
fn compressed_child_txt_zip() -> Bytes {
  // Project-owned fixture generated by .tmp/generate_nested_rawcap_fixture.mbtx.
  // ZIP SHA256 c3415468db585f39e2dd7b602051b5bdd5969d225ca93560efb96c2f9cd7d957.
  // One DEFLATE child.txt: 256 lines of "nested payload marker\n" (5632 bytes).
  // The entire archive is 169 bytes, so root raw extent and entry extent differ.
  b"\x50\x4b\x03\x04\x14\x00\x00\x00\x08\x00\x00\x00\x00\x00\x0e\x8a\x4f\x96\x35\x00\x00\x00\x00\x16\x00\x00\x09\x00\x00\x00\x63\x68\x69\x6c\x64\x2e\x74\x78\x74\xed\xc8\xb9\x0d\x80\x00\x08\x00\xc0\xde\x29\x58\x8d\x04\x2a\xdf\xa0\x8d\xdb\x3b\x87\xc9\xb5\x77\xf4\xfd\x74\xc5\x95\xef\x76\x66\xc5\x9e\xb3\xf6\x2c\x94\x52\x4a\x29\xa5\x94\x52\x4a\x29\xa5\x94\x52\x4a\xff\xae\x1f\x50\x4b\x01\x02\x14\x00\x14\x00\x00\x00\x08\x00\x00\x00\x00\x00\x0e\x8a\x4f\x96\x35\x00\x00\x00\x00\x16\x00\x00\x09\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x63\x68\x69\x6c\x64\x2e\x74\x78\x74\x50\x4b\x05\x06\x00\x00\x00\x00\x01\x00\x01\x00\x37\x00\x00\x00\x5c\x00\x00\x00\x00\x00"
}

///|
async test "nested ZIP child larger than exact root raw cap preserves its full output" {
  let zip = compressed_child_txt_zip()
  assert_eq(zip.length(), 169)
  let input = @lib.Input::from_bytes(zip, source_name="compressed-child.zip")
  let options = @lib.ConvertOptions::default().with_format_hint(Some("zip"))
  let baseline = @lib.convert(input, options~).unwrap()
  assert_eq(
    baseline.content.split("nested payload marker").to_array().length() - 1,
    256,
  )
  let options = options.with_limits(
    @lib.ResourceLimits::default().with_max_input_bytes(zip.length().to_int64()),
  )
  let actual = match @lib.convert(input, options~) {
    Ok(output) => output
    Err(error) =>
      fail("root ZIP=169 bytes and child TXT=5632 bytes: " + error.to_string())
  }
  assert_eq(actual.content, baseline.content)
}

///|
async test "nested ZIP still rejects an original archive above the raw byte ceiling" {
  let zip = compressed_child_txt_zip()
  let options = @lib.ConvertOptions::default()
    .with_format_hint(Some("zip"))
    .with_limits(@lib.ResourceLimits::default().with_max_input_bytes(168L))
  match
    @lib.convert(
      @lib.Input::from_bytes(zip, source_name="compressed-child.zip"),
      options~,
    ) {
    Err(ResourceLimitExceeded(kind~, observed~, limit~)) => {
      assert_eq(kind, "input_bytes")
      assert_eq(observed, 169L)
      assert_eq(limit, 168L)
    }
    _ =>
      fail("an oversized root archive must still fail its original-byte limit")
  }
}
